---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is FOIR and how does it determine loan eligibility?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FOIR stands for Fixed Obligation to Income Ratio. Indian banks (like SBI, HDFC, ICICI) generally restrict your total monthly loan EMIs (including existing loans and the new loan) to 40%–55% of your net monthly income to ensure you don't default."
      }
    },
    {
      "@type": "Question",
      "name": "How can I increase my loan eligibility?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can increase eligibility by: 1) Adding a co-applicant (spouse or parent) to combine incomes, 2) Opting for a longer tenure (up to 30 years for home loans), 3) Paying off existing credit cards or personal loans to lower your FOIR, and 4) Maintaining a CIBIL score of 750+."
      }
    },
    {
      "@type": "Question",
      "name": "What CIBIL score is required for maximum loan approval?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A CIBIL score of 750 and above qualifies you for the lowest interest rates and highest loan amounts. Scores between 700–749 are acceptable with slightly higher rates, while scores below 650 may lead to rejection."
      }
    }
  ]
};
---

<CalculatorLayout
  title="Loan Eligibility Calculator 2026 — Check Maximum Loan & FOIR Amount"
  description="Check your maximum loan eligibility based on monthly salary, existing EMIs, interest rate, and bank FOIR limit (40%-55%). Find out how much home or personal loan you qualify for."
  keywords="loan eligibility calculator, foir calculator, home loan eligibility sbi hdfc, max loan eligibility, how much loan can i get on my salary, salary to loan calculator"
  calculator="Loan Eligibility Calculator"
  category="Loan & EMI"
  categoryBadge="badge-loan"
  structuredData={faqData}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
        <h2 class="font-[var(--font-heading)] font-semibold text-lg sm:text-xl text-[var(--color-text-primary)]">
          Income & Obligations
        </h2>
        <span class="text-xs text-[var(--color-accent-indigo)] font-semibold px-2 py-0.5 rounded-full bg-indigo-500/10 border border-indigo-500/20">Standard Bank FOIR</span>
      </div>

      <!-- Gross Monthly Income -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="le-income" class="text-sm font-medium text-[var(--color-text-secondary)]">Net Monthly In-Hand Salary</label>
          <div class="flex items-center gap-1">
            <span class="text-[var(--color-text-muted)] text-sm">₹</span>
            <input type="number" id="le-income-input" class="num-input w-32 text-right" value="100000" min="15000" max="1000000" step="5000"/>
          </div>
        </div>
        <input type="range" id="le-income" min="15000" max="500000" step="5000" value="100000"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>₹15,000</span>
          <span>₹2.5 Lakhs</span>
          <span>₹5.0 Lakhs</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="le-income" data-val="50000">₹50K</button>
          <button type="button" class="preset-chip active" data-preset-for="le-income" data-val="100000">₹1.0 Lakh</button>
          <button type="button" class="preset-chip" data-preset-for="le-income" data-val="150000">₹1.5 Lakhs</button>
          <button type="button" class="preset-chip" data-preset-for="le-income" data-val="250000">₹2.5 Lakhs</button>
        </div>
      </div>

      <!-- Existing Monthly EMIs -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="le-existing" class="text-sm font-medium text-[var(--color-text-secondary)]">Existing Monthly Loan EMIs</label>
          <div class="flex items-center gap-1">
            <span class="text-[var(--color-text-muted)] text-sm">₹</span>
            <input type="number" id="le-existing-input" class="num-input w-28 text-right" value="10000" min="0" max="200000" step="1000"/>
          </div>
        </div>
        <input type="range" id="le-existing" min="0" max="100000" step="1000" value="10000"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1">
          <span>₹0 (Debt Free)</span>
          <span>₹50,000</span>
          <span>₹1.0 Lakh</span>
        </div>
      </div>

      <!-- Interest Rate & Tenure -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="le-rate" class="text-xs font-medium text-[var(--color-text-secondary)]">Interest Rate (p.a.)</label>
            <div class="flex items-center gap-1">
              <input type="number" id="le-rate-input" class="num-input w-16 text-right text-xs" value="8.5" min="6" max="18" step="0.1"/>
              <span class="text-[var(--color-text-muted)] text-xs">%</span>
            </div>
          </div>
          <input type="range" id="le-rate" min="6" max="18" step="0.1" value="8.5"/>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="le-tenure" class="text-xs font-medium text-[var(--color-text-secondary)]">Tenure Period</label>
            <div class="flex items-center gap-1">
              <input type="number" id="le-tenure-input" class="num-input w-16 text-right text-xs" value="20" min="1" max="30"/>
              <span class="text-[var(--color-text-muted)] text-xs">Yrs</span>
            </div>
          </div>
          <input type="range" id="le-tenure" min="1" max="30" step="1" value="20"/>
        </div>
      </div>

      <!-- FOIR Limit -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="le-foir" class="text-sm font-medium text-[var(--color-text-secondary)]">Bank FOIR Limit Percentage</label>
          <div class="flex items-center gap-1">
            <input type="number" id="le-foir-input" class="num-input w-20 text-right" value="50" min="30" max="65"/>
            <span class="text-[var(--color-text-muted)] text-sm">%</span>
          </div>
        </div>
        <input type="range" id="le-foir" min="30" max="65" step="5" value="50"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1">
          <span>35% (Conservative)</span>
          <span>50% (Standard)</span>
          <span>65% (High Income)</span>
        </div>
      </div>
    </div>

    <!-- Results Section -->
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="result-card p-6 md:p-8 flex flex-col justify-between">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold text-emerald-400">Maximum Sanctionable Loan</span>
          <div id="le-max-loan" class="result-value text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--color-text-primary)] mt-1">₹46,09,807</div>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">Estimated loan amount banks will approve based on your income</p>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-[var(--color-border)]">
          <div>
            <span class="text-xs text-[var(--color-text-muted)]">Max Allowable EMI</span>
            <div id="le-max-emi" class="text-lg font-bold text-emerald-400 mt-0.5">₹40,000 / mo</div>
          </div>
          <div>
            <span class="text-xs text-[var(--color-text-muted)]">Existing Obligations</span>
            <div id="le-obligations-disp" class="text-lg font-bold text-[var(--color-text-primary)] mt-0.5">₹10,000 / mo</div>
          </div>
        </div>
      </div>

      <!-- Capacity Visualizer -->
      <div class="glass-card p-5 space-y-3">
        <div class="flex justify-between items-center text-xs">
          <span class="text-[var(--color-text-secondary)]">Total Monthly Income</span>
          <span id="le-total-income-disp" class="font-bold text-[var(--color-text-primary)]">₹1,00,000</span>
        </div>
        <div class="flex justify-between items-center text-xs">
          <span class="text-[var(--color-text-secondary)]">Total Committed Debt Capacity (50%)</span>
          <span id="le-total-capacity-disp" class="font-bold text-indigo-400">₹50,000 / mo</span>
        </div>
        <div class="flex justify-between items-center text-xs">
          <span class="text-[var(--color-text-secondary)]">Safe Disposable Income Left</span>
          <span id="le-disposable-disp" class="font-bold text-emerald-600 dark:text-emerald-400">₹50,000 / mo</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Educational Explainer -->
  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-[var(--color-text-secondary)]">
    <div class="glass-card p-6 space-y-3">
      <h4 class="font-[var(--font-heading)] font-semibold text-base text-[var(--color-text-primary)]">How Banks Calculate Loan Eligibility</h4>
      <p>Banks use the formula:</p>
      <p class="font-mono text-xs bg-slate-100 dark:bg-slate-900/80 p-2.5 rounded border border-slate-300 dark:border-slate-700 text-indigo-700 dark:text-indigo-300 font-medium">
        Max Allowable EMI = (Net Monthly Salary × FOIR %) - Existing EMIs
      </p>
      <p>Then, based on the loan interest rate and your selected tenure, the maximum principal is computed using the present value of loan formula.</p>
    </div>
    <div class="glass-card p-6 space-y-3">
      <h4 class="font-[var(--font-heading)] font-semibold text-base text-[var(--color-text-primary)]">Key Eligibility Enhancers</h4>
      <ul class="list-disc pl-5 space-y-1.5">
        <li><strong>Tenure Extension:</strong> Extending tenure from 15 to 25 years can increase eligibility by up to 25%.</li>
        <li><strong>Co-applicant:</strong> Adding working spouse or co-borrower adds 100% of their net salary into the formula.</li>
        <li><strong>Pre-close Personal Loans:</strong> A ₹15K existing EMI reduces your home loan capacity by approx ₹17 Lakhs!</li>
      </ul>
    </div>
  </div>
</CalculatorLayout>

<script>
  import { calculateLoanEligibility, formatCurrency } from '../../utils/calculations';

  const incomeInput = document.getElementById('le-income') as HTMLInputElement;
  const incomeNum = document.getElementById('le-income-input') as HTMLInputElement;
  const existInput = document.getElementById('le-existing') as HTMLInputElement;
  const existNum = document.getElementById('le-existing-input') as HTMLInputElement;
  const rateInput = document.getElementById('le-rate') as HTMLInputElement;
  const rateNum = document.getElementById('le-rate-input') as HTMLInputElement;
  const tenureInput = document.getElementById('le-tenure') as HTMLInputElement;
  const tenureNum = document.getElementById('le-tenure-input') as HTMLInputElement;
  const foirInput = document.getElementById('le-foir') as HTMLInputElement;
  const foirNum = document.getElementById('le-foir-input') as HTMLInputElement;

  function sync(range: HTMLInputElement, num: HTMLInputElement) {
    range?.addEventListener('input', () => {
      num.value = range.value;
      updateEligibility();
    });
    num?.addEventListener('input', () => {
      range.value = num.value;
      updateEligibility();
    });
  }

  sync(incomeInput, incomeNum);
  sync(existInput, existNum);
  sync(rateInput, rateNum);
  sync(tenureInput, tenureNum);
  sync(foirInput, foirNum);

  document.querySelectorAll('.preset-chip[data-preset-for="le-income"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-chip[data-preset-for="le-income"]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const val = btn.getAttribute('data-val') || '100000';
      if (incomeInput && incomeNum) {
        incomeInput.value = val;
        incomeNum.value = val;
        updateEligibility();
      }
    });
  });

  function updateEligibility() {
    const income = parseFloat(incomeInput?.value || '100000');
    const existing = parseFloat(existInput?.value || '10000');
    const rate = parseFloat(rateInput?.value || '8.5');
    const tenure = parseFloat(tenureInput?.value || '20');
    const foir = parseFloat(foirInput?.value || '50');

    const res = calculateLoanEligibility(income, existing, rate, tenure, foir);

    const mlEl = document.getElementById('le-max-loan');
    const meEl = document.getElementById('le-max-emi');
    const obEl = document.getElementById('le-obligations-disp');
    const incEl = document.getElementById('le-total-income-disp');
    const capEl = document.getElementById('le-total-capacity-disp');
    const dispEl = document.getElementById('le-disposable-disp');

    if (mlEl) mlEl.textContent = formatCurrency(res.maxLoanAmount);
    if (meEl) meEl.textContent = `${formatCurrency(res.maxAllowableEMI)} / mo`;
    if (obEl) obEl.textContent = `${formatCurrency(existing)} / mo`;
    if (incEl) incEl.textContent = formatCurrency(income);
    if (capEl) capEl.textContent = `${formatCurrency(Math.round(income * (foir / 100)))} / mo`;
    if (dispEl) dispEl.textContent = `${formatCurrency(Math.max(0, income - res.maxAllowableEMI - existing))} / mo`;
  }

  updateEligibility();
</script>
