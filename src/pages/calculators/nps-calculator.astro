---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---
<CalculatorLayout title="NPS Calculator — National Pension System Returns" description="Calculate your NPS corpus and pension amount. Plan your retirement with the National Pension System." keywords="nps calculator, national pension system, nps returns, pension calculator, nps calculator india" calculator="NPS Calculator" category="Provident Fund & Retirement" categoryBadge="badge-retirement">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in"><h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6">NPS Details</h2>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Monthly Investment</label><div class="flex items-center gap-1"><span class="text-[var(--color-text-muted)] text-sm">₹</span><input type="number" id="np-a-input" class="num-input w-32 text-right" value="5000" min="500" max="200000" step="500"/></div></div><input type="range" id="np-a" min="500" max="200000" step="500" value="5000"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>₹500</span><span>₹2L</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Expected Return (p.a.)</label><div class="flex items-center gap-1"><input type="number" id="np-r-input" class="num-input w-24 text-right" value="10" min="5" max="15" step="0.5"/><span class="text-[var(--color-text-muted)] text-sm">%</span></div></div><input type="range" id="np-r" min="5" max="15" step="0.5" value="10"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>5%</span><span>15%</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Current Age</label><div class="flex items-center gap-1"><input type="number" id="np-age-input" class="num-input w-20 text-right" value="30" min="18" max="60"/><span class="text-[var(--color-text-muted)] text-sm">Years</span></div></div><input type="range" id="np-age" min="18" max="60" step="1" value="30"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>18</span><span>60</span></div></div>
      <div class="p-3 rounded-lg bg-[var(--color-accent-indigo)]/10 border border-[var(--color-accent-indigo)]/20 text-xs text-[var(--color-text-secondary)]">💡 NPS matures at age 60. At least 40% of corpus must be used for annuity (pension). Up to 60% can be withdrawn as lump sum tax-free.</div></div>
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="glass-card p-6 md:p-8 animate-pulse-glow"><div class="text-sm text-[var(--color-text-muted)] mb-1">Total Corpus at 60</div><div id="np-corpus" class="result-value gradient-text">₹0</div></div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3"><div class="glass-card-static p-4"><div class="text-xs text-[var(--color-text-muted)] mb-1">Invested</div><div id="np-inv" class="font-[var(--font-mono)] font-bold text-base text-[var(--color-accent-cyan)]">₹0</div></div><div class="glass-card-static p-4"><div class="text-xs text-[var(--color-text-muted)] mb-1">Lumpsum (60%)</div><div id="np-lump" class="font-[var(--font-mono)] font-bold text-base text-[var(--color-accent-emerald)]">₹0</div></div><div class="glass-card-static p-4"><div class="text-xs text-[var(--color-text-muted)] mb-1">Annuity (40%)</div><div id="np-ann" class="font-[var(--font-mono)] font-bold text-base text-[var(--color-accent-violet)]">₹0</div></div></div>
      <div class="glass-card-static p-6 flex justify-center"><div class="chart-container"><canvas id="np-chart"></canvas></div></div></div>
  </div>
</CalculatorLayout>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" defer></script>
<script>function fmt(n){const s=Math.abs(Math.round(n)).toString();let f=s.length<=3?s:'';if(s.length>3){f=s.slice(-3);let r=s.slice(0,-3);while(r.length>2){f=r.slice(-2)+','+f;r=r.slice(0,-2);}if(r.length)f=r+','+f;}return '₹'+f;}let chart=null;['np-a','np-r','np-age'].forEach(function(id){var s=document.getElementById(id),i=document.getElementById(id+'-input');s&&s.addEventListener('input',function(){i.value=s.value;calc();});i&&i.addEventListener('input',function(){var v=parseFloat(i.value);if(!isNaN(v)){s.value=String(Math.max(parseFloat(s.min),Math.min(parseFloat(s.max),v)));}calc();});});function calc(){var P=parseFloat(document.getElementById('np-a-input').value)||0,R=parseFloat(document.getElementById('np-r-input').value)||0,age=parseFloat(document.getElementById('np-age-input').value)||0;var years=60-age;if(years<=0)return;var n=years*12,r=R/12/100;var fv=P*((Math.pow(1+r,n)-1)/r)*(1+r);var invested=P*n;document.getElementById('np-corpus').textContent=fmt(fv);document.getElementById('np-inv').textContent=fmt(invested);document.getElementById('np-lump').textContent=fmt(fv*0.6);document.getElementById('np-ann').textContent=fmt(fv*0.4);var c=document.getElementById('np-chart');if(!c)return;if(chart)chart.destroy();chart=new Chart(c.getContext('2d'),{type:'doughnut',data:{labels:['Invested','Returns'],datasets:[{data:[invested,fv-invested],backgroundColor:['#06b6d4','#10b981'],borderColor:['#0a0a0f','#0a0a0f'],borderWidth:3,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:true,cutout:'70%',plugins:{legend:{position:'bottom',labels:{color:'#9ca3af',padding:16,usePointStyle:true,font:{size:12}}},tooltip:{callbacks:{label:function(c){return ' '+c.label+': '+fmt(c.raw);}}}}}});}calc();</script>
