---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import bankData from '../../data/bank-rates.json';
---
<CalculatorLayout title="Appliance Loan EMI Calculator — No Cost EMI" description="Calculate EMI for consumer durables and appliances. Check no-cost EMI options." keywords="appliance loan emi, consumer durable loan, no cost emi calculator" calculator="Appliance Loan EMI Calculator" category="Loan & EMI" categoryBadge="badge-loan">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in"><h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6">Appliance Loan Details</h2>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Price</label><div class="flex items-center gap-1"><span class="text-[var(--color-text-muted)] text-sm">₹</span><input type="number" id="ap-a-input" class="num-input w-32 text-right" value="50000" min="5000" max="500000" step="1000"/></div></div><input type="range" id="ap-a" min="5000" max="500000" step="1000" value="50000"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>₹5K</span><span>₹5L</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Interest Rate</label><div class="flex items-center gap-1"><input type="number" id="ap-r-input" class="num-input w-24 text-right" value="12" min="0" max="24" step="0.5"/><span class="text-[var(--color-text-muted)] text-sm">%</span></div></div><input type="range" id="ap-r" min="0" max="24" step="0.5" value="12"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>0% (No Cost)</span><span>24%</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">EMI Tenure</label><div class="flex items-center gap-1"><input type="number" id="ap-t-input" class="num-input w-20 text-right" value="12" min="3" max="36"/><span class="text-[var(--color-text-muted)] text-sm">Months</span></div></div><input type="range" id="ap-t" min="3" max="36" step="3" value="12"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>3 Mo</span><span>36 Mo</span></div></div></div>
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="glass-card p-6 md:p-8 animate-pulse-glow"><div class="text-sm text-[var(--color-text-muted)] mb-1">Monthly EMI</div><div id="ap-emi" class="result-value gradient-text">₹0</div></div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3"><div class="glass-card-static p-4"><div class="text-xs text-[var(--color-text-muted)] mb-1">Price</div><div id="ap-p" class="font-[var(--font-mono)] font-bold text-base text-[var(--color-accent-cyan)]">₹0</div></div><div class="glass-card-static p-4"><div class="text-xs text-[var(--color-text-muted)] mb-1">Interest</div><div id="ap-i" class="font-[var(--font-mono)] font-bold text-base text-[var(--color-accent-rose)]">₹0</div></div><div class="glass-card-static p-4"><div class="text-xs text-[var(--color-text-muted)] mb-1">Total</div><div id="ap-tot" class="font-[var(--font-mono)] font-bold text-base text-[var(--color-text-primary)]">₹0</div></div></div>
      <div class="glass-card-static p-6 flex justify-center"><div class="chart-container"><canvas id="ap-chart"></canvas></div></div></div>
  </div>
</CalculatorLayout>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" defer></script>
<script>function fmt(n){const s=Math.abs(Math.round(n)).toString();let f=s.length<=3?s:'';if(s.length>3){f=s.slice(-3);let r=s.slice(0,-3);while(r.length>2){f=r.slice(-2)+','+f;r=r.slice(0,-2);}if(r.length)f=r+','+f;}return '₹'+f;}let chart=null;['ap-a','ap-r','ap-t'].forEach(function(id){var s=document.getElementById(id),i=document.getElementById(id+'-input');s&&s.addEventListener('input',function(){i.value=s.value;calc();});i&&i.addEventListener('input',function(){var v=parseFloat(i.value);if(!isNaN(v)){s.value=String(Math.max(parseFloat(s.min),Math.min(parseFloat(s.max),v)));}calc();});});function calc(){var P=parseFloat(document.getElementById('ap-a-input').value)||0,R=parseFloat(document.getElementById('ap-r-input').value)||0,n=parseFloat(document.getElementById('ap-t-input').value)||0,r=R/12/100;var emi=r>0?Math.round((P*r*Math.pow(1+r,n))/(Math.pow(1+r,n)-1)):Math.round(P/n),total=emi*n,interest=total-P;document.getElementById('ap-emi').textContent=fmt(emi);document.getElementById('ap-p').textContent=fmt(P);document.getElementById('ap-i').textContent=fmt(interest);document.getElementById('ap-tot').textContent=fmt(total);var c=document.getElementById('ap-chart');if(!c)return;if(chart)chart.destroy();chart=new Chart(c.getContext('2d'),{type:'doughnut',data:{labels:['Price','Interest'],datasets:[{data:[P,Math.max(0,interest)],backgroundColor:['#06b6d4','#f43f5e'],borderColor:['#0a0a0f','#0a0a0f'],borderWidth:3,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:true,cutout:'70%',plugins:{legend:{position:'bottom',labels:{color:'#9ca3af',padding:16,usePointStyle:true,font:{size:12}}},tooltip:{callbacks:{label:function(c){return ' '+c.label+': '+fmt(c.raw);}}}}}});}calc();</script>
