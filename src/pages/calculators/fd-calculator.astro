---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import bankData from '../../data/bank-rates.json';

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is Fixed Deposit (FD) maturity interest calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most Indian banks compound FD interest on a quarterly basis using the compound interest formula: A = P × (1 + r/n)^(n×t), where P is deposit principal, r is annual interest rate in decimal, n is compounding frequency (4 for quarterly), and t is tenure in years."
      }
    },
    {
      "@type": "Question",
      "name": "Do Senior Citizens get extra interest on Fixed Deposits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, almost all Indian commercial banks (SBI, HDFC, ICICI, etc.) offer an additional 0.50% to 0.75% per annum interest rate to senior citizens (aged 60 and above)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the TDS threshold on FD interest income in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Banks deduct 10% TDS if interest earned across all your FDs in that bank exceeds ₹40,000 in a financial year (₹50,000 for senior citizens). If your total income is below the taxable threshold, you can submit Form 15G or 15H to avoid TDS deduction."
      }
    },
    {
      "@type": "Question",
      "name": "Can I save tax with a 5-Year Fixed Deposit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. A 5-year Tax Saving Fixed Deposit qualifies for tax deduction up to ₹1.5 Lakh under Section 80C of the Income Tax Act. However, it comes with a mandatory 5-year lock-in period with no premature withdrawal allowed."
      }
    }
  ]
};
---

<CalculatorLayout
  title="FD Calculator — Fixed Deposit Interest & Bank Rate Comparison (2026)"
  description="Calculate your Fixed Deposit maturity value and quarterly compounding interest. Compare latest FD interest rates across SBI, HDFC, ICICI, Axis, PNB and BoB."
  keywords="fd calculator, fixed deposit calculator, sbi fd interest rates, hdfc fd rates 2026, icici fd calculator, senior citizen fd rates, tax saving fd 80c, bank fixed deposit returns"
  calculator="FD Calculator"
  category="Savings"
  categoryBadge="badge-savings"
  structuredData={faqData}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
        <h2 class="font-[var(--font-heading)] font-semibold text-lg sm:text-xl text-[var(--color-text-primary)]">
          Fixed Deposit Parameters
        </h2>
        <span class="text-xs text-[var(--color-accent-emerald)] font-medium">Quarterly Compounding</span>
      </div>

      <!-- Deposit Amount -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="fd-amount" class="text-sm font-medium text-[var(--color-text-secondary)]">Deposit Amount</label>
          <div class="flex items-center gap-1">
            <span class="text-[var(--color-text-muted)] text-sm">₹</span>
            <input type="number" id="fd-amount-input" class="num-input w-36 text-right" value="100000" min="1000" max="100000000" step="1000" />
          </div>
        </div>
        <input type="range" id="fd-amount" min="1000" max="100000000" step="1000" value="100000" />
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>₹1K</span>
          <span>₹10L</span>
          <span>₹10Cr</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="fd-amount" data-val="50000">₹50K</button>
          <button type="button" class="preset-chip active" data-preset-for="fd-amount" data-val="100000">₹1.0 Lakh</button>
          <button type="button" class="preset-chip" data-preset-for="fd-amount" data-val="200000">₹2.0 Lakh</button>
          <button type="button" class="preset-chip" data-preset-for="fd-amount" data-val="500000">₹5.0 Lakh</button>
          <button type="button" class="preset-chip" data-preset-for="fd-amount" data-val="1000000">₹10 Lakh</button>
        </div>
      </div>

      <!-- Interest Rate -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="fd-rate" class="text-sm font-medium text-[var(--color-text-secondary)]">Interest Rate (p.a.)</label>
          <div class="flex items-center gap-1">
            <input type="number" id="fd-rate-input" class="num-input w-24 text-right" value="7.1" min="1" max="15" step="0.05" />
            <span class="text-[var(--color-text-muted)] text-sm">%</span>
          </div>
        </div>
        <input type="range" id="fd-rate" min="1" max="15" step="0.05" value="7.1" />
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>1.0%</span>
          <span>7.1% (Top Banks)</span>
          <span>15.0%</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="fd-rate" data-val="6.8">6.8% (SBI 1Yr)</button>
          <button type="button" class="preset-chip active" data-preset-for="fd-rate" data-val="7.1">7.1% (HDFC 1Yr)</button>
          <button type="button" class="preset-chip" data-preset-for="fd-rate" data-val="7.6">7.6% (Senior)</button>
        </div>
      </div>

      <!-- Tenure -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="fd-tenure" class="text-sm font-medium text-[var(--color-text-secondary)]">Tenure (Years)</label>
          <div class="flex items-center gap-1">
            <input type="number" id="fd-tenure-input" class="num-input w-20 text-right" value="3" min="1" max="10" />
            <span class="text-[var(--color-text-muted)] text-sm">Years</span>
          </div>
        </div>
        <input type="range" id="fd-tenure" min="1" max="10" step="1" value="3" />
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>1 Year</span>
          <span>5 Yrs (Tax Saver)</span>
          <span>10 Years</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="fd-tenure" data-val="1">1 Year</button>
          <button type="button" class="preset-chip" data-preset-for="fd-tenure" data-val="2">2 Years</button>
          <button type="button" class="preset-chip active" data-preset-for="fd-tenure" data-val="3">3 Years</button>
          <button type="button" class="preset-chip" data-preset-for="fd-tenure" data-val="5">5 Years (80C)</button>
        </div>
      </div>

      <!-- Compounding Frequency -->
      <div>
        <label class="text-sm font-medium text-[var(--color-text-secondary)] mb-2 block">Compounding Frequency</label>
        <div class="flex gap-2 flex-wrap">
          <button data-freq="12" class="tab-btn text-xs">Monthly</button>
          <button data-freq="4" class="tab-btn active text-xs">Quarterly (Standard)</button>
          <button data-freq="2" class="tab-btn text-xs">Half-Yearly</button>
          <button data-freq="1" class="tab-btn text-xs">Yearly</button>
        </div>
      </div>
    </div>

    <!-- Results Section -->
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="glass-card p-6 md:p-8 animate-pulse-glow">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">Maturity Proceeds</span>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-[var(--color-accent-emerald)]/10 text-[var(--color-accent-emerald)] border border-[var(--color-accent-emerald)]/20 font-medium">Guaranteed Growth</span>
        </div>
        <div id="fd-maturity" class="result-value gradient-text">₹0</div>
        <p class="text-xs text-[var(--color-text-secondary)] mt-2">Principal + compound interest receivable at maturity</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="glass-card-static p-5">
          <div class="text-xs text-[var(--color-text-muted)] mb-1 font-medium">Principal Deposited</div>
          <div id="fd-principal" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-cyan)]">₹0</div>
        </div>
        <div class="glass-card-static p-5">
          <div class="text-xs text-[var(--color-text-muted)] mb-1 font-medium">Total Interest Earned</div>
          <div id="fd-interest" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-emerald)]">₹0</div>
        </div>
      </div>

      <div class="glass-card-static p-6 flex flex-col items-center justify-center">
        <div class="text-xs text-[var(--color-text-muted)] mb-3 font-medium">Principal vs Interest Income</div>
        <div class="chart-container">
          <canvas id="fd-chart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Bank Rate Comparison -->
  <div class="mt-10 glass-card-static p-6 md:p-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-6">
      <h2 class="font-[var(--font-heading)] font-semibold text-xl text-[var(--color-text-primary)]">
        Bank-wise Fixed Deposit Interest Rates (2026)
      </h2>
      <span class="text-xs text-[var(--color-accent-emerald)] bg-[var(--color-accent-emerald)]/10 px-2.5 py-1 rounded-full border border-[var(--color-accent-emerald)]/20 w-fit">
        Updated {bankData.lastUpdated}
      </span>
    </div>
    <div class="table-responsive-container">
      <table class="bank-table">
        <thead>
          <tr>
            <th>Bank</th>
            <th>1 Year FD</th>
            <th>2 Years FD</th>
            <th>3 Years FD</th>
            <th>5 Years (Tax Saver)</th>
            <th>Senior Citizen (1Yr)</th>
          </tr>
        </thead>
        <tbody>
          {bankData.banks.map(b => (
            <tr>
              <td class="font-medium text-[var(--color-text-primary)]">
                <span class="mr-2">{b.logo}</span>{b.shortName}
              </td>
              <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-emerald)] font-semibold">{b.rates.fd.general['1yr']}%</td>
              <td class="font-[var(--font-mono)] text-sm">{b.rates.fd.general['2yr']}%</td>
              <td class="font-[var(--font-mono)] text-sm">{b.rates.fd.general['5yr']}%</td>
              <td class="font-[var(--font-mono)] text-sm">{b.rates.fd.general['5yr']}%</td>
              <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-amber)] font-semibold">{b.rates.fd.senior['1yr']}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-[var(--color-text-muted)] mt-4">
      * Rates are for domestic deposits below ₹3 Crore and are subject to periodic bank revision.
    </p>
  </div>

  <!-- FAQ Section -->
  <div class="mt-10 glass-card-static p-6 md:p-8">
    <h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6 text-[var(--color-text-primary)]">
      Frequently Asked Questions (Fixed Deposits)
    </h2>
    <div class="space-y-4">
      {faqData.mainEntity.map(faq => (
        <details class="group">
          <summary class="cursor-pointer text-[var(--color-text-primary)] font-medium text-sm sm:text-base flex items-center justify-between p-3.5 rounded-lg hover:bg-[var(--color-bg-elevated)] transition-colors">
            <span>{faq.name}</span>
            <svg class="w-4 h-4 text-[var(--color-text-muted)] group-open:rotate-180 transition-transform shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed p-3.5 pt-1">
            {faq.acceptedAnswer.text}
          </p>
        </details>
      ))}
    </div>
  </div>
</CalculatorLayout>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" defer></script>
<script>
  function fmt(n: number) {
    const s = Math.abs(Math.round(n)).toString();
    let f = s.length <= 3 ? s : '';
    if (s.length > 3) {
      f = s.slice(-3);
      let r = s.slice(0, -3);
      while (r.length > 2) {
        f = r.slice(-2) + ',' + f;
        r = r.slice(0, -2);
      }
      if (r.length) f = r + ',' + f;
    }
    return '₹' + f;
  }

  let freq = 4;
  let chart: any = null;

  ['fd-amount', 'fd-rate', 'fd-tenure'].forEach(id => {
    const s = document.getElementById(id) as HTMLInputElement;
    const i = document.getElementById(id + '-input') as HTMLInputElement;
    s?.addEventListener('input', () => { i.value = s.value; calc(); });
    i?.addEventListener('input', () => {
      let v = parseFloat(i.value);
      if (!isNaN(v)) {
        v = Math.max(parseFloat(s.min), Math.min(parseFloat(s.max), v));
        s.value = String(v);
      }
      calc();
    });
  });

  // Preset Chips Listener
  document.querySelectorAll('.preset-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-preset-for');
      const val = btn.getAttribute('data-val');
      if (!target || !val) return;

      const slider = document.getElementById(target) as HTMLInputElement;
      const input = document.getElementById(target + '-input') as HTMLInputElement;
      if (slider && input) {
        slider.value = val;
        input.value = val;
      }
      document.querySelectorAll(`[data-preset-for="${target}"]`).forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      calc();
    });
  });

  document.querySelectorAll('[data-freq]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-freq]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      freq = parseInt((btn as HTMLElement).dataset.freq!);
      calc();
    });
  });

  function calc() {
    const P = parseFloat((document.getElementById('fd-amount-input') as HTMLInputElement).value) || 0;
    const R = parseFloat((document.getElementById('fd-rate-input') as HTMLInputElement).value) || 0;
    const t = parseFloat((document.getElementById('fd-tenure-input') as HTMLInputElement).value) || 0;
    const r = R / 100;
    const maturity = Math.round(P * Math.pow(1 + r / freq, freq * t));
    const interest = maturity - P;

    document.getElementById('fd-maturity')!.textContent = fmt(maturity);
    document.getElementById('fd-principal')!.textContent = fmt(P);
    document.getElementById('fd-interest')!.textContent = fmt(interest);

    const c = document.getElementById('fd-chart') as HTMLCanvasElement;
    if (!c) return;
    if (chart) chart.destroy();

    // @ts-ignore
    chart = new Chart(c.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Deposit Principal', 'Compounded Interest'],
        datasets: [{
          data: [P, interest],
          backgroundColor: ['#06b6d4', '#10b981'],
          borderColor: ['#090d16', '#090d16'],
          borderWidth: 3,
          hoverOffset: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        cutout: '72%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: { color: '#94a3b8', padding: 14, usePointStyle: true, font: { size: 12 } }
          },
          tooltip: {
            callbacks: {
              label: (ctx: any) => ` ${ctx.label}: ${fmt(ctx.raw)}`
            }
          }
        }
      }
    });
  }

  calc();
</script>
