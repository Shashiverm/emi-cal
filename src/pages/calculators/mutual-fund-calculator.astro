---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between Absolute Return and CAGR in Mutual Funds?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolute return measures simple percentage growth without factoring in time ((Current - Initial) / Initial × 100). CAGR (Compounded Annual Growth Rate) measures the annualized smooth growth rate of an investment over multiple years, reflecting the true compounding power."
      }
    },
    {
      "@type": "Question",
      "name": "What are the historical benchmark returns of Indian Mutual Fund categories?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Historically over 10+ year horizons in India: Large Cap Funds deliver 12%–14% CAGR, Flexi/Multi Cap Funds deliver 13%–15%, Mid Cap Funds deliver 15%–17%, and Small Cap Funds deliver 17%–20% CAGR (with higher volatility)."
      }
    }
  ]
};
---

<CalculatorLayout
  title="Mutual Fund Returns Calculator (CAGR & Wealth Projection 2026)"
  description="Calculate Absolute Returns and Annualized CAGR for Mutual Funds. Compare SIP vs Lumpsum modes across Large-Cap, Mid-Cap, Small-Cap and Index fund benchmarks."
  keywords="mutual fund returns calculator, cagr calculator mutual fund, sip vs lumpsum mutual fund, rolling returns calculator, small cap vs large cap return, mutual fund wealth calculator"
  calculator="Mutual Fund Returns Calculator"
  category="Investment"
  categoryBadge="badge-investment"
  structuredData={faqData}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
        <h2 class="font-[var(--font-heading)] font-semibold text-lg sm:text-xl text-[var(--color-text-primary)]">
          Investment Strategy
        </h2>
        <span class="text-xs text-[var(--color-accent-emerald)] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20">Compounding Wealth</span>
      </div>

      <!-- Mode: SIP vs Lumpsum -->
      <div>
        <label class="text-sm font-medium text-[var(--color-text-secondary)] mb-2 block">Investment Method</label>
        <div class="grid grid-cols-2 gap-3">
          <button type="button" id="mf-mode-sip" class="mode-btn active py-2.5 px-3 rounded-lg border border-indigo-500 bg-indigo-500/20 text-xs font-semibold text-indigo-300 transition-all text-center">
            Monthly SIP
          </button>
          <button type="button" id="mf-mode-lump" class="mode-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-slate-800/60 text-xs font-semibold text-slate-400 hover:text-white transition-all text-center">
            One-Time Lumpsum
          </button>
        </div>
      </div>

      <!-- Amount -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="mf-amount" id="mf-amount-label" class="text-sm font-medium text-[var(--color-text-secondary)]">Monthly Investment Amount</label>
          <div class="flex items-center gap-1">
            <span class="text-[var(--color-text-muted)] text-sm">₹</span>
            <input type="number" id="mf-amount-input" class="num-input w-32 text-right" value="10000" min="500" max="1000000" step="500"/>
          </div>
        </div>
        <input type="range" id="mf-amount" min="500" max="100000" step="500" value="10000"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span id="mf-min-lbl">₹500</span>
          <span id="mf-mid-lbl">₹50,000</span>
          <span id="mf-max-lbl">₹1.0 Lakh</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="mf-amount" data-val="5000">₹5K</button>
          <button type="button" class="preset-chip active" data-preset-for="mf-amount" data-val="10000">₹10K</button>
          <button type="button" class="preset-chip" data-preset-for="mf-amount" data-val="25000">₹25K</button>
          <button type="button" class="preset-chip" data-preset-for="mf-amount" data-val="50000">₹50K</button>
        </div>
      </div>

      <!-- Category Expected Return -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="mf-rate" class="text-sm font-medium text-[var(--color-text-secondary)]">Expected Annual Return (CAGR)</label>
          <div class="flex items-center gap-1">
            <input type="number" id="mf-rate-input" class="num-input w-20 text-right" value="13.5" min="4" max="30" step="0.5"/>
            <span class="text-[var(--color-text-muted)] text-sm">%</span>
          </div>
        </div>
        <input type="range" id="mf-rate" min="4" max="25" step="0.5" value="13.5"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>8% (Debt/Conservative)</span>
          <span>13.5% (Flexi-Cap)</span>
          <span>18% (Small-Cap)</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="mf-rate" data-val="12">12% (Nifty 50)</button>
          <button type="button" class="preset-chip active" data-preset-for="mf-rate" data-val="13.5">13.5% (Flexi Cap)</button>
          <button type="button" class="preset-chip" data-preset-for="mf-rate" data-val="15">15% (Mid Cap)</button>
          <button type="button" class="preset-chip" data-preset-for="mf-rate" data-val="18">18% (Small Cap)</button>
        </div>
      </div>

      <!-- Tenure -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="mf-tenure" class="text-sm font-medium text-[var(--color-text-secondary)]">Investment Time Horizon</label>
          <div class="flex items-center gap-1">
            <input type="number" id="mf-tenure-input" class="num-input w-20 text-right" value="10" min="1" max="35"/>
            <span class="text-[var(--color-text-muted)] text-sm">Yrs</span>
          </div>
        </div>
        <input type="range" id="mf-tenure" min="1" max="30" step="1" value="10"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>1 Year</span>
          <span>15 Years</span>
          <span>30 Years</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="mf-tenure" data-val="5">5 Yrs</button>
          <button type="button" class="preset-chip active" data-preset-for="mf-tenure" data-val="10">10 Yrs</button>
          <button type="button" class="preset-chip" data-preset-for="mf-tenure" data-val="15">15 Yrs</button>
          <button type="button" class="preset-chip" data-preset-for="mf-tenure" data-val="20">20 Yrs</button>
        </div>
      </div>
    </div>

    <!-- Results Section -->
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="result-card p-6 md:p-8 flex flex-col justify-between">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold text-emerald-400">Total Projected Corpus</span>
          <div id="mf-total-corpus" class="result-value text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--color-text-primary)] mt-1">₹25,12,790</div>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">Estimated future wealth compounded over your tenure</p>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-[var(--color-border)]">
          <div>
            <span class="text-xs text-[var(--color-text-muted)]">Invested Amount</span>
            <div id="mf-total-invested" class="text-lg font-bold text-[var(--color-text-primary)] mt-0.5">₹12,00,000</div>
          </div>
          <div>
            <span class="text-xs text-[var(--color-text-muted)]">Wealth Gain</span>
            <div id="mf-wealth-gain" class="text-lg font-bold text-emerald-400 mt-0.5">₹13,12,790</div>
          </div>
        </div>
      </div>

      <!-- Ratio Visualizer -->
      <div class="glass-card p-5">
        <div class="flex items-center justify-between text-xs mb-2">
          <span class="text-[var(--color-text-secondary)]">Gain vs Principal Breakdown</span>
          <span id="mf-gain-pct" class="font-bold text-emerald-400">52.2% Returns</span>
        </div>
        <div class="w-full bg-slate-800 rounded-full h-3 flex overflow-hidden">
          <div id="mf-inv-bar" class="bg-indigo-500 h-full transition-all duration-300" style="width: 47.8%"></div>
          <div id="mf-gain-bar" class="bg-emerald-400 h-full transition-all duration-300" style="width: 52.2%"></div>
        </div>
        <div class="flex justify-between text-[11px] text-[var(--color-text-muted)] mt-2">
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-indigo-500"></span> Principal Invested</span>
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400"></span> Capital Gains</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Educational Explainer -->
  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-[var(--color-text-secondary)]">
    <div class="glass-card p-6 space-y-3">
      <h4 class="font-[var(--font-heading)] font-semibold text-base text-[var(--color-text-primary)]">Why SIP Beats Timing the Market</h4>
      <p>Systematic Investment Plans (SIP) enforce rupee-cost averaging: you buy more mutual fund units when the market falls and fewer units when prices are elevated. Over 10+ years, this eliminates the risk of trying to catch market peaks and bottoms.</p>
    </div>
    <div class="glass-card p-6 space-y-3">
      <h4 class="font-[var(--font-heading)] font-semibold text-base text-[var(--color-text-primary)]">Capital Gains Tax on Mutual Funds</h4>
      <ul class="list-disc pl-5 space-y-1.5">
        <li><strong>Equity Funds:</strong> LTCG (held &gt; 12 months) is taxed at 12.5% for gains above ₹1.25 Lakhs. STCG is taxed at 20%.</li>
        <li><strong>Debt Funds:</strong> Taxed at your applicable income tax slab rate.</li>
      </ul>
    </div>
  </div>
</CalculatorLayout>

<script>
  import { calculateSIP, calculateCompoundInterest, formatCurrency } from '../../utils/calculations';

  const amountInput = document.getElementById('mf-amount') as HTMLInputElement;
  const amountNum = document.getElementById('mf-amount-input') as HTMLInputElement;
  const rateInput = document.getElementById('mf-rate') as HTMLInputElement;
  const rateNum = document.getElementById('mf-rate-input') as HTMLInputElement;
  const tenureInput = document.getElementById('mf-tenure') as HTMLInputElement;
  const tenureNum = document.getElementById('mf-tenure-input') as HTMLInputElement;
  const sipBtn = document.getElementById('mf-mode-sip');
  const lumpBtn = document.getElementById('mf-mode-lump');
  const amountLbl = document.getElementById('mf-amount-label');

  let isSIP = true;

  function sync(range: HTMLInputElement, num: HTMLInputElement) {
    range?.addEventListener('input', () => {
      num.value = range.value;
      updateMF();
    });
    num?.addEventListener('input', () => {
      range.value = num.value;
      updateMF();
    });
  }

  sync(amountInput, amountNum);
  sync(rateInput, rateNum);
  sync(tenureInput, tenureNum);

  sipBtn?.addEventListener('click', () => {
    isSIP = true;
    sipBtn.className = 'mode-btn active py-2.5 px-3 rounded-lg border border-indigo-500 bg-indigo-500/20 text-xs font-semibold text-indigo-300 transition-all text-center';
    if (lumpBtn) lumpBtn.className = 'mode-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-slate-800/60 text-xs font-semibold text-slate-400 hover:text-white transition-all text-center';
    if (amountLbl) amountLbl.textContent = 'Monthly Investment Amount';
    if (amountInput) {
      amountInput.max = '100000';
      if (parseFloat(amountInput.value) > 100000) amountInput.value = '10000';
    }
    if (amountNum) {
      amountNum.max = '100000';
      if (parseFloat(amountNum.value) > 100000) amountNum.value = '10000';
    }
    updateMF();
  });

  lumpBtn?.addEventListener('click', () => {
    isSIP = false;
    lumpBtn.className = 'mode-btn active py-2.5 px-3 rounded-lg border border-indigo-500 bg-indigo-500/20 text-xs font-semibold text-indigo-300 transition-all text-center';
    if (sipBtn) sipBtn.className = 'mode-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-slate-800/60 text-xs font-semibold text-slate-400 hover:text-white transition-all text-center';
    if (amountLbl) amountLbl.textContent = 'Total One-Time Lumpsum';
    if (amountInput) amountInput.max = '5000000';
    if (amountNum) amountNum.max = '5000000';
    updateMF();
  });

  document.querySelectorAll('.preset-chip[data-preset-for="mf-amount"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-chip[data-preset-for="mf-amount"]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const val = btn.getAttribute('data-val') || '10000';
      if (amountInput && amountNum) {
        amountInput.value = val;
        amountNum.value = val;
        updateMF();
      }
    });
  });

  document.querySelectorAll('.preset-chip[data-preset-for="mf-rate"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-chip[data-preset-for="mf-rate"]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const val = btn.getAttribute('data-val') || '13.5';
      if (rateInput && rateNum) {
        rateInput.value = val;
        rateNum.value = val;
        updateMF();
      }
    });
  });

  document.querySelectorAll('.preset-chip[data-preset-for="mf-tenure"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-chip[data-preset-for="mf-tenure"]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const val = btn.getAttribute('data-val') || '10';
      if (tenureInput && tenureNum) {
        tenureInput.value = val;
        tenureNum.value = val;
        updateMF();
      }
    });
  });

  function updateMF() {
    const amount = parseFloat(amountInput?.value || '10000');
    const rate = parseFloat(rateInput?.value || '13.5');
    const tenure = parseFloat(tenureInput?.value || '10');

    let totalInvested = 0;
    let totalCorpus = 0;
    let wealthGain = 0;

    if (isSIP) {
      const res = calculateSIP(amount, rate, tenure);
      totalCorpus = res.futureValue;
      totalInvested = res.totalInvested;
      wealthGain = res.totalReturns;
    } else {
      const res = calculateCompoundInterest(amount, rate, tenure, 1);
      totalCorpus = res.totalAmount;
      totalInvested = amount;
      wealthGain = res.interest;
    }

    const cEl = document.getElementById('mf-total-corpus');
    const iEl = document.getElementById('mf-total-invested');
    const gEl = document.getElementById('mf-wealth-gain');
    const iBar = document.getElementById('mf-inv-bar');
    const gBar = document.getElementById('mf-gain-bar');
    const pEl = document.getElementById('mf-gain-pct');

    if (cEl) cEl.textContent = formatCurrency(totalCorpus);
    if (iEl) iEl.textContent = formatCurrency(totalInvested);
    if (gEl) gEl.textContent = formatCurrency(wealthGain);

    if (totalCorpus > 0) {
      const gPct = Math.round((wealthGain / totalCorpus) * 100);
      const iPct = 100 - gPct;
      if (iBar) iBar.style.width = `${iPct}%`;
      if (gBar) gBar.style.width = `${gPct}%`;
      if (pEl) pEl.textContent = `${gPct}% Returns`;
    }
  }

  updateMF();
</script>
