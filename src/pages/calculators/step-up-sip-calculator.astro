---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---
<CalculatorLayout title="Step-Up SIP Calculator — SIP with Yearly Increase" description="Calculate SIP returns with an annual step-up increase in your monthly investment." keywords="step up sip calculator, sip with yearly increase, top up sip, step up sip returns" calculator="Step-Up SIP Calculator" category="Investment" categoryBadge="badge-investment">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in"><h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6">Step-Up SIP Details</h2>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Monthly SIP Amount</label><div class="flex items-center gap-1"><span class="text-[var(--color-text-muted)] text-sm">₹</span><input type="number" id="su-a-input" class="num-input w-32 text-right" value="10000" min="500" max="500000" step="500"/></div></div><input type="range" id="su-a" min="500" max="500000" step="500" value="10000"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>₹500</span><span>₹5L</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Annual Step-Up</label><div class="flex items-center gap-1"><input type="number" id="su-s-input" class="num-input w-20 text-right" value="10" min="0" max="50" step="1"/><span class="text-[var(--color-text-muted)] text-sm">%</span></div></div><input type="range" id="su-s" min="0" max="50" step="1" value="10"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>0%</span><span>50%</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Expected Return (p.a.)</label><div class="flex items-center gap-1"><input type="number" id="su-r-input" class="num-input w-24 text-right" value="12" min="1" max="30" step="0.5"/><span class="text-[var(--color-text-muted)] text-sm">%</span></div></div><input type="range" id="su-r" min="1" max="30" step="0.5" value="12"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>1%</span><span>30%</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Time Period</label><div class="flex items-center gap-1"><input type="number" id="su-t-input" class="num-input w-20 text-right" value="10" min="1" max="30"/><span class="text-[var(--color-text-muted)] text-sm">Years</span></div></div><input type="range" id="su-t" min="1" max="30" step="1" value="10"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>1 Yr</span><span>30 Yr</span></div></div></div>
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="glass-card p-6 md:p-8 animate-pulse-glow"><div class="text-sm text-[var(--color-text-muted)] mb-1">Total Value</div><div id="su-total" class="result-value gradient-text">₹0</div></div>
      <div class="grid grid-cols-2 gap-4"><div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Total Invested</div><div id="su-inv" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-cyan)]">₹0</div></div><div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Est. Returns</div><div id="su-ret" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-emerald)]">₹0</div></div></div>
      <div class="glass-card-static p-6 flex justify-center"><div class="chart-container"><canvas id="su-chart"></canvas></div></div></div>
  </div>
</CalculatorLayout>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" defer></script>
<script>function fmt(n){const s=Math.abs(Math.round(n)).toString();let f=s.length<=3?s:'';if(s.length>3){f=s.slice(-3);let r=s.slice(0,-3);while(r.length>2){f=r.slice(-2)+','+f;r=r.slice(0,-2);}if(r.length)f=r+','+f;}return '₹'+f;}let chart=null;['su-a','su-s','su-r','su-t'].forEach(function(id){var s=document.getElementById(id),i=document.getElementById(id+'-input');s&&s.addEventListener('input',function(){i.value=s.value;calc();});i&&i.addEventListener('input',function(){var v=parseFloat(i.value);if(!isNaN(v)){s.value=String(Math.max(parseFloat(s.min),Math.min(parseFloat(s.max),v)));}calc();});});function calc(){var P=parseFloat(document.getElementById('su-a-input').value)||0,S=parseFloat(document.getElementById('su-s-input').value)||0,R=parseFloat(document.getElementById('su-r-input').value)||0,T=parseFloat(document.getElementById('su-t-input').value)||0;var r=R/12/100,invested=0,fv=0,cur=P;for(var y=0;y<T;y++){for(var m=0;m<12;m++){var rem=(T-y)*12-m;fv+=cur*Math.pow(1+r,rem);invested+=cur;}cur=Math.round(cur*(1+S/100));}var ret=fv-invested;document.getElementById('su-total').textContent=fmt(fv);document.getElementById('su-inv').textContent=fmt(invested);document.getElementById('su-ret').textContent=fmt(ret);var c=document.getElementById('su-chart');if(!c)return;if(chart)chart.destroy();chart=new Chart(c.getContext('2d'),{type:'doughnut',data:{labels:['Invested','Returns'],datasets:[{data:[invested,ret],backgroundColor:['#06b6d4','#10b981'],borderColor:['#0a0a0f','#0a0a0f'],borderWidth:3,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:true,cutout:'70%',plugins:{legend:{position:'bottom',labels:{color:'#9ca3af',padding:16,usePointStyle:true,font:{size:12}}},tooltip:{callbacks:{label:function(c){return ' '+c.label+': '+fmt(c.raw);}}}}}});}calc();</script>
