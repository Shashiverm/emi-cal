---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---
<CalculatorLayout title="SWP Calculator — Systematic Withdrawal Plan" description="Calculate returns on your Systematic Withdrawal Plan. See final balance after regular withdrawals." keywords="swp calculator, systematic withdrawal plan, swp returns, mutual fund swp" calculator="SWP Calculator" category="Investment" categoryBadge="badge-investment">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in"><h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6">SWP Details</h2>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Total Investment</label><div class="flex items-center gap-1"><span class="text-[var(--color-text-muted)] text-sm">₹</span><input type="number" id="sw-a-input" class="num-input w-36 text-right" value="5000000" min="100000" max="100000000" step="100000"/></div></div><input type="range" id="sw-a" min="100000" max="100000000" step="100000" value="5000000"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>₹1L</span><span>₹10Cr</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Monthly Withdrawal</label><div class="flex items-center gap-1"><span class="text-[var(--color-text-muted)] text-sm">₹</span><input type="number" id="sw-w-input" class="num-input w-32 text-right" value="30000" min="1000" max="500000" step="1000"/></div></div><input type="range" id="sw-w" min="1000" max="500000" step="1000" value="30000"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>₹1K</span><span>₹5L</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Expected Return (p.a.)</label><div class="flex items-center gap-1"><input type="number" id="sw-r-input" class="num-input w-24 text-right" value="8" min="1" max="20" step="0.5"/><span class="text-[var(--color-text-muted)] text-sm">%</span></div></div><input type="range" id="sw-r" min="1" max="20" step="0.5" value="8"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>1%</span><span>20%</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Time Period</label><div class="flex items-center gap-1"><input type="number" id="sw-t-input" class="num-input w-20 text-right" value="10" min="1" max="30"/><span class="text-[var(--color-text-muted)] text-sm">Years</span></div></div><input type="range" id="sw-t" min="1" max="30" step="1" value="10"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>1 Yr</span><span>30 Yr</span></div></div></div>
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="glass-card p-6 md:p-8 animate-pulse-glow"><div class="text-sm text-[var(--color-text-muted)] mb-1">Final Balance</div><div id="sw-final" class="result-value gradient-text">₹0</div></div>
      <div class="grid grid-cols-2 gap-4"><div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Total Invested</div><div id="sw-inv" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-cyan)]">₹0</div></div><div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Total Withdrawn</div><div id="sw-with" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-amber)]">₹0</div></div></div>
      <div class="glass-card-static p-6 flex justify-center"><div class="chart-container"><canvas id="sw-chart"></canvas></div></div></div>
  </div>
</CalculatorLayout>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" defer></script>
<script>function fmt(n){const s=Math.abs(Math.round(n)).toString();let f=s.length<=3?s:'';if(s.length>3){f=s.slice(-3);let r=s.slice(0,-3);while(r.length>2){f=r.slice(-2)+','+f;r=r.slice(0,-2);}if(r.length)f=r+','+f;}return '₹'+f;}let chart=null;['sw-a','sw-w','sw-r','sw-t'].forEach(function(id){var s=document.getElementById(id),i=document.getElementById(id+'-input');s&&s.addEventListener('input',function(){i.value=s.value;calc();});i&&i.addEventListener('input',function(){var v=parseFloat(i.value);if(!isNaN(v)){s.value=String(Math.max(parseFloat(s.min),Math.min(parseFloat(s.max),v)));}calc();});});function calc(){var P=parseFloat(document.getElementById('sw-a-input').value)||0,W=parseFloat(document.getElementById('sw-w-input').value)||0,R=parseFloat(document.getElementById('sw-r-input').value)||0,T=parseFloat(document.getElementById('sw-t-input').value)||0;var r=R/12/100,bal=P,withdrawn=0;for(var m=1;m<=T*12;m++){bal=bal*(1+r)-W;withdrawn+=W;if(bal<=0){bal=0;break;}}document.getElementById('sw-final').textContent=fmt(bal);document.getElementById('sw-inv').textContent=fmt(P);document.getElementById('sw-with').textContent=fmt(withdrawn);var c=document.getElementById('sw-chart');if(!c)return;if(chart)chart.destroy();chart=new Chart(c.getContext('2d'),{type:'doughnut',data:{labels:['Final Balance','Total Withdrawn'],datasets:[{data:[Math.max(0,bal),withdrawn],backgroundColor:['#10b981','#f59e0b'],borderColor:['#0a0a0f','#0a0a0f'],borderWidth:3,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:true,cutout:'70%',plugins:{legend:{position:'bottom',labels:{color:'#9ca3af',padding:16,usePointStyle:true,font:{size:12}}},tooltip:{callbacks:{label:function(c){return ' '+c.label+': '+fmt(c.raw);}}}}}});}calc();</script>
