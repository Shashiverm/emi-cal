---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Stamp Duty and who pays it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Stamp Duty is a state-level tax levied by the Government on legal property transfer documents to validate ownership. It is paid entirely by the property buyer during registration."
      }
    },
    {
      "@type": "Question",
      "name": "Do women get discounts on stamp duty rates in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Several states offer a 1% to 2% stamp duty rebate for female property buyers. For example, in Delhi, women pay 4% vs 6% for men. In Maharashtra, women pay 5% vs 6% for men."
      }
    },
    {
      "@type": "Question",
      "name": "Can stamp duty and registration fees be included in a home loan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "As per RBI guidelines, banks cannot include stamp duty and registration fees as part of the home loan amount for properties costing over ₹10 Lakhs. Borrowers must fund these charges from their own equity."
      }
    }
  ]
};
---

<CalculatorLayout
  title="Stamp Duty & Registration Calculator 2026 — State-Wise Property Charges"
  description="Calculate state-wise property Stamp Duty and Registration charges across Maharashtra, Karnataka, Delhi, UP, Tamil Nadu & more. Female buyer concessions included."
  keywords="stamp duty calculator india, property registration charges calculator, stamp duty maharashtra 2026, stamp duty delhi women concession, karnataka stamp duty, stamp duty on flat purchase"
  calculator="Stamp Duty Calculator"
  category="Tax & Salary"
  categoryBadge="badge-tax"
  structuredData={faqData}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
        <h2 class="font-[var(--font-heading)] font-semibold text-lg sm:text-xl text-[var(--color-text-primary)]">
          Property & Buyer Details
        </h2>
        <span class="text-xs text-[var(--color-accent-indigo)] font-semibold px-2 py-0.5 rounded-full bg-indigo-500/10 border border-indigo-500/20">State Legal Rates</span>
      </div>

      <!-- State Selection -->
      <div>
        <label for="sd-state" class="text-sm font-medium text-[var(--color-text-secondary)] mb-1.5 block">State / Union Territory</label>
        <select id="sd-state" class="w-full text-xs sm:text-sm font-medium rounded-lg p-3 bg-slate-800 border border-slate-700 text-slate-200">
          <option value="maharashtra" selected>Maharashtra (Mumbai / Pune — 6% + ₹30K cap)</option>
          <option value="delhi">Delhi (6% Male / 4% Female)</option>
          <option value="karnataka">Karnataka (Bengaluru — 5% + 1% Reg)</option>
          <option value="uttar_pradesh">Uttar Pradesh (Noida / Lucknow — 7% Male / 6% Female)</option>
          <option value="tamil_nadu">Tamil Nadu (Chennai — 7% + 4% Reg)</option>
          <option value="telangana">Telangana (Hyderabad — 6% + 0.5% Reg)</option>
          <option value="gujarat">Gujarat (Ahmedabad — 4.9% + 1% Reg)</option>
          <option value="west_bengal">West Bengal (Kolkata — 6% + 1% Reg)</option>
        </select>
      </div>

      <!-- Property Value -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="sd-value" class="text-sm font-medium text-[var(--color-text-secondary)]">Property Agreement Value (or Circle Rate)</label>
          <div class="flex items-center gap-1">
            <span class="text-[var(--color-text-muted)] text-sm">₹</span>
            <input type="number" id="sd-value-input" class="num-input w-32 text-right" value="8000000" min="500000" max="100000000" step="100000"/>
          </div>
        </div>
        <input type="range" id="sd-value" min="1000000" max="30000000" step="250000" value="8000000"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>₹10 Lakhs</span>
          <span>₹1.5 Crores</span>
          <span>₹3.0 Crores</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="sd-value" data-val="5000000">₹50 Lakhs</button>
          <button type="button" class="preset-chip active" data-preset-for="sd-value" data-val="8000000">₹80 Lakhs</button>
          <button type="button" class="preset-chip" data-preset-for="sd-value" data-val="12000000">₹1.20 Cr</button>
          <button type="button" class="preset-chip" data-preset-for="sd-value" data-val="20000000">₹2.00 Cr</button>
        </div>
      </div>

      <!-- Buyer Gender -->
      <div>
        <label class="text-sm font-medium text-[var(--color-text-secondary)] mb-2 block">Primary Buyer Gender</label>
        <div class="grid grid-cols-3 gap-2.5">
          <button type="button" class="gender-btn active py-2.5 px-3 rounded-lg border border-indigo-500 bg-indigo-500/20 text-xs font-semibold text-indigo-300 transition-all text-center" data-val="male">
            Male Buyer
          </button>
          <button type="button" class="gender-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-slate-800/60 text-xs font-semibold text-slate-400 hover:text-white transition-all text-center" data-val="female">
            Female Buyer (Rebate)
          </button>
          <button type="button" class="gender-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-slate-800/60 text-xs font-semibold text-slate-400 hover:text-white transition-all text-center" data-val="joint">
            Joint (Male + Female)
          </button>
        </div>
      </div>
    </div>

    <!-- Results Section -->
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="result-card p-6 md:p-8 flex flex-col justify-between">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold text-emerald-400">Total Government Legal Charges</span>
          <div id="sd-total-charges" class="result-value text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--color-text-primary)] mt-1">₹5,10,000</div>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">Combined Stamp Duty + Registration Fees to be paid at Sub-Registrar</p>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-[var(--color-border)]">
          <div>
            <span class="text-xs text-[var(--color-text-muted)]">Stamp Duty Amount</span>
            <div id="sd-duty-amount" class="text-lg font-bold text-[var(--color-text-primary)] mt-0.5">₹4,80,000</div>
          </div>
          <div>
            <span class="text-xs text-[var(--color-text-muted)]">Registration Fee</span>
            <div id="sd-reg-amount" class="text-lg font-bold text-indigo-400 mt-0.5">₹30,000 (Capped)</div>
          </div>
        </div>
      </div>

      <!-- Highlights Box -->
      <div class="glass-card p-5 space-y-3">
        <div class="flex justify-between items-center text-xs">
          <span class="text-[var(--color-text-secondary)]">Effective Stamp Duty Rate</span>
          <span id="sd-rate-disp" class="font-bold text-[var(--color-text-primary)]">6.0%</span>
        </div>
        <div class="flex justify-between items-center text-xs">
          <span class="text-[var(--color-text-secondary)]">Registration Rate</span>
          <span id="sd-reg-rate-disp" class="font-bold text-indigo-400">1.0% (Max ₹30,000)</span>
        </div>
        <div class="flex justify-between items-center text-xs">
          <span class="text-[var(--color-text-secondary)]">Section 80C Tax Deduction</span>
          <span class="font-bold text-emerald-400">Up to ₹1.5L in purchase year</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Educational Explainer -->
  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-[var(--color-text-secondary)]">
    <div class="glass-card p-6 space-y-3">
      <h4 class="font-[var(--font-heading)] font-semibold text-base text-[var(--color-text-primary)]">Tax Deduction on Stamp Duty (Section 80C)</h4>
      <p>Borrowers can claim a tax deduction for stamp duty and registration charges under <strong>Section 80C up to ₹1,50,000</strong>. This deduction can only be claimed in the financial year in which the payment was actually made.</p>
    </div>
    <div class="glass-card p-6 space-y-3">
      <h4 class="font-[var(--font-heading)] font-semibold text-base text-[var(--color-text-primary)]">Circle Rate vs Agreement Value</h4>
      <p>Stamp duty is calculated on the <strong>higher</strong> of the actual transaction value or the government circle rate (ready reckoner rate). Under Section 56(2)(x), if transaction price is lower than circle rate by more than 10%, the difference is taxed as other income!</p>
    </div>
  </div>
</CalculatorLayout>

<script>
  import { calculateStampDuty, formatCurrency } from '../../utils/calculations';

  const stateSelect = document.getElementById('sd-state') as HTMLSelectElement;
  const valueInput = document.getElementById('sd-value') as HTMLInputElement;
  const valueNum = document.getElementById('sd-value-input') as HTMLInputElement;
  let buyerGender = 'male';

  function sync(range: HTMLInputElement, num: HTMLInputElement) {
    range?.addEventListener('input', () => {
      num.value = range.value;
      updateStampDuty();
    });
    num?.addEventListener('input', () => {
      range.value = num.value;
      updateStampDuty();
    });
  }

  sync(valueInput, valueNum);
  stateSelect?.addEventListener('change', updateStampDuty);

  document.querySelectorAll('.gender-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.gender-btn').forEach(b => {
        b.className = 'gender-btn py-2.5 px-3 rounded-lg border border-slate-700 bg-slate-800/60 text-xs font-semibold text-slate-400 hover:text-white transition-all text-center';
      });
      btn.className = 'gender-btn active py-2.5 px-3 rounded-lg border border-indigo-500 bg-indigo-500/20 text-xs font-semibold text-indigo-300 transition-all text-center';
      buyerGender = btn.getAttribute('data-val') || 'male';
      updateStampDuty();
    });
  });

  document.querySelectorAll('.preset-chip[data-preset-for="sd-value"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-chip[data-preset-for="sd-value"]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const val = btn.getAttribute('data-val') || '8000000';
      if (valueInput && valueNum) {
        valueInput.value = val;
        valueNum.value = val;
        updateStampDuty();
      }
    });
  });

  function updateStampDuty() {
    const state = stateSelect?.value || 'maharashtra';
    const val = parseFloat(valueInput?.value || '8000000');

    const res = calculateStampDuty(val, state, buyerGender);

    const totalEl = document.getElementById('sd-total-charges');
    const dutyEl = document.getElementById('sd-duty-amount');
    const regEl = document.getElementById('sd-reg-amount');
    const rateEl = document.getElementById('sd-rate-disp');
    const regRateEl = document.getElementById('sd-reg-rate-disp');

    if (totalEl) totalEl.textContent = formatCurrency(res.totalCharges);
    if (dutyEl) dutyEl.textContent = formatCurrency(res.stampDutyAmount);
    if (regEl) regEl.textContent = formatCurrency(res.registrationFee);
    if (rateEl) rateEl.textContent = `${res.stampDutyRate}%`;
    if (regRateEl) regRateEl.textContent = `${res.registrationRate}%${state === 'maharashtra' ? ' (Max ₹30,000)' : ''}`;
  }

  updateStampDuty();
</script>
