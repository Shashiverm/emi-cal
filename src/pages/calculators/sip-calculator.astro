---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a Systematic Investment Plan (SIP)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Systematic Investment Plan (SIP) allows investors to invest a fixed sum of money periodically (typically monthly) into mutual funds. SIP enforces financial discipline and leverages rupee cost averaging and compound interest to build long-term wealth."
      }
    },
    {
      "@type": "Question",
      "name": "How is SIP return calculated mathematically?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SIP returns are calculated using the compound interest formula for annuities: M = P × [((1 + i)^n - 1) / i] × (1 + i), where P is the monthly investment amount, i is the periodic interest rate (annual return ÷ 12 ÷ 100), and n is the total number of monthly payments."
      }
    },
    {
      "@type": "Question",
      "name": "How much SIP is needed per month to get ₹1 Crore in 15 years?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Assuming a realistic 12% annualized return from equity mutual funds, a monthly SIP of approximately ₹19,819 for 15 years accumulates a total corpus of ₹1 Crore (Invested: ₹35.67 Lakh, Est. Returns: ₹64.33 Lakh)."
      }
    },
    {
      "@type": "Question",
      "name": "Are mutual fund SIP returns taxable in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. In equity mutual funds, gains realized after 1 year are classified as Long-Term Capital Gains (LTCG) and taxed at 12.5% for gains exceeding ₹1.25 Lakh per financial year (as per Budget 2024 revisions). Short-Term Capital Gains (holding less than 1 year) are taxed at 20%."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between SIP and Lumpsum investment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SIP allows periodic installment investments that average out market volatility (rupee cost averaging). Lumpsum involves deploying a large single capital sum at once, which works best when market valuations are low."
      }
    }
  ]
};
---

<CalculatorLayout
  title="SIP Calculator — Mutual Fund SIP Returns & ₹1 Crore Wealth Estimator"
  description="Free SIP Calculator to estimate mutual fund returns with compounding interest. Calculate wealth growth, compare 10%, 12%, and 15% CAGR scenarios, and plan your ₹1 Crore milestone."
  keywords="sip calculator, mutual fund sip calculator, sip returns calculator, sip calculator groww, sip calculator sbi, systematic investment plan, 1 crore sip calculator, sip interest rate, compounding calculator india"
  calculator="SIP Calculator"
  category="Investment"
  categoryBadge="badge-investment"
  structuredData={faqData}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Calculator Inputs -->
    <div class="glass-card p-6 md:p-8 animate-fade-in space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
        <h2 class="font-[var(--font-heading)] font-semibold text-lg sm:text-xl text-[var(--color-text-primary)]">
          SIP Investment Details
        </h2>
        <span class="text-xs text-[var(--color-accent-emerald)] font-medium">Monthly Compounding</span>
      </div>

      <!-- Monthly Investment -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="sip-amount" class="text-sm font-medium text-[var(--color-text-secondary)]">Monthly Investment</label>
          <div class="flex items-center gap-1">
            <span class="text-[var(--color-text-muted)] text-sm">₹</span>
            <input type="number" id="sip-amount-input" class="num-input w-36 text-right" value="10000" min="500" max="1000000" step="500" />
          </div>
        </div>
        <input type="range" id="sip-amount" min="500" max="1000000" step="500" value="10000" />
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>₹500</span>
          <span>₹50,000</span>
          <span>₹10 Lakh</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="sip-amount" data-val="1000">₹1,000</button>
          <button type="button" class="preset-chip" data-preset-for="sip-amount" data-val="2500">₹2,500</button>
          <button type="button" class="preset-chip" data-preset-for="sip-amount" data-val="5000">₹5,000</button>
          <button type="button" class="preset-chip active" data-preset-for="sip-amount" data-val="10000">₹10,000</button>
          <button type="button" class="preset-chip" data-preset-for="sip-amount" data-val="25000">₹25,000</button>
          <button type="button" class="preset-chip" data-preset-for="sip-amount" data-val="50000">₹50,000</button>
        </div>
      </div>

      <!-- Expected Return Rate -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="sip-rate" class="text-sm font-medium text-[var(--color-text-secondary)]">Expected Return Rate (p.a.)</label>
          <div class="flex items-center gap-1">
            <input type="number" id="sip-rate-input" class="num-input w-24 text-right" value="12" min="1" max="30" step="0.5" />
            <span class="text-[var(--color-text-muted)] text-sm">%</span>
          </div>
        </div>
        <input type="range" id="sip-rate" min="1" max="30" step="0.5" value="12" />
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>1%</span>
          <span>12% (Index Avg)</span>
          <span>30%</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="sip-rate" data-val="10">10% (Hybrid/Debt)</button>
          <button type="button" class="preset-chip active" data-preset-for="sip-rate" data-val="12">12% (Nifty 50 Index)</button>
          <button type="button" class="preset-chip" data-preset-for="sip-rate" data-val="15">15% (Mid & Small Cap)</button>
        </div>
      </div>

      <!-- Time Period -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="sip-tenure" class="text-sm font-medium text-[var(--color-text-secondary)]">Investment Horizon</label>
          <div class="flex items-center gap-1">
            <input type="number" id="sip-tenure-input" class="num-input w-20 text-right" value="10" min="1" max="40" />
            <span class="text-[var(--color-text-muted)] text-sm">Years</span>
          </div>
        </div>
        <input type="range" id="sip-tenure" min="1" max="40" step="1" value="10" />
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>1 Year</span>
          <span>10 Yrs</span>
          <span>40 Years</span>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="sip-tenure" data-val="5">5 Yrs</button>
          <button type="button" class="preset-chip active" data-preset-for="sip-tenure" data-val="10">10 Yrs</button>
          <button type="button" class="preset-chip" data-preset-for="sip-tenure" data-val="15">15 Yrs</button>
          <button type="button" class="preset-chip" data-preset-for="sip-tenure" data-val="20">20 Yrs</button>
          <button type="button" class="preset-chip" data-preset-for="sip-tenure" data-val="25">25 Yrs</button>
        </div>
      </div>
    </div>

    <!-- Results Section -->
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <!-- Total Value Card -->
      <div class="glass-card p-6 md:p-8 animate-pulse-glow">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">Expected Maturity Corpus</span>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-[var(--color-accent-emerald)]/10 text-[var(--color-accent-emerald)] border border-[var(--color-accent-emerald)]/20 font-medium">Power of Compounding</span>
        </div>
        <div id="sip-total" class="result-value gradient-text">₹0</div>
        <p class="text-xs text-[var(--color-text-secondary)] mt-2">Estimated future value before tax deduction</p>
      </div>

      <!-- Financial Metrics -->
      <div class="grid grid-cols-2 gap-4">
        <div class="glass-card-static p-5">
          <div class="text-xs text-[var(--color-text-muted)] mb-1 font-medium">Total Amount Invested</div>
          <div id="sip-invested" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-cyan)]">₹0</div>
        </div>
        <div class="glass-card-static p-5">
          <div class="text-xs text-[var(--color-text-muted)] mb-1 font-medium">Estimated Wealth Gain</div>
          <div id="sip-returns" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-emerald)]">₹0</div>
        </div>
      </div>

      <!-- Donut Chart -->
      <div class="glass-card-static p-6 flex flex-col items-center justify-center">
        <div class="text-xs text-[var(--color-text-muted)] mb-3 font-medium">Invested Capital vs Wealth Gain</div>
        <div class="chart-container">
          <canvas id="sip-chart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Milestone Table: The Road to ₹1 Crore -->
  <div class="mt-10 glass-card-static p-6 md:p-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-6">
      <h2 class="font-[var(--font-heading)] font-semibold text-xl text-[var(--color-text-primary)]">
        The Road to ₹1 Crore — Monthly SIP Required at 12% CAGR
      </h2>
      <span class="text-xs text-[var(--color-accent-indigo)] bg-[var(--color-accent-indigo)]/10 px-2.5 py-1 rounded-full border border-[var(--color-accent-indigo)]/20 w-fit">
        Compounding Milestone
      </span>
    </div>
    <div class="table-responsive-container">
      <table class="bank-table">
        <thead>
          <tr>
            <th>Time Horizon</th>
            <th>Monthly SIP Needed</th>
            <th>Total Invested Capital</th>
            <th>Est. Wealth Gain</th>
            <th>Final Target Corpus</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="font-medium text-[var(--color-text-primary)]">5 Years</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-rose)] font-semibold">₹1,21,250 / mo</td>
            <td class="font-[var(--font-mono)] text-sm">₹72,75,000</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-emerald)]">₹27,25,000</td>
            <td class="font-[var(--font-mono)] text-sm font-bold text-[var(--color-text-primary)]">₹1,00,00,000</td>
          </tr>
          <tr>
            <td class="font-medium text-[var(--color-text-primary)]">10 Years</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-amber)] font-semibold">₹43,041 / mo</td>
            <td class="font-[var(--font-mono)] text-sm">₹51,64,920</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-emerald)]">₹48,35,080</td>
            <td class="font-[var(--font-mono)] text-sm font-bold text-[var(--color-text-primary)]">₹1,00,00,000</td>
          </tr>
          <tr class="bg-[var(--color-accent-cyan)]/5">
            <td class="font-medium text-[var(--color-text-primary)]">15 Years (Sweet Spot)</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-cyan)] font-bold">₹19,819 / mo</td>
            <td class="font-[var(--font-mono)] text-sm">₹35,67,420</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-emerald)] font-bold">₹64,32,580</td>
            <td class="font-[var(--font-mono)] text-sm font-bold text-[var(--color-text-primary)]">₹1,00,00,000</td>
          </tr>
          <tr>
            <td class="font-medium text-[var(--color-text-primary)]">20 Years</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-emerald)] font-bold">₹10,009 / mo</td>
            <td class="font-[var(--font-mono)] text-sm">₹24,02,160</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-emerald)] font-bold">₹75,97,840</td>
            <td class="font-[var(--font-mono)] text-sm font-bold text-[var(--color-text-primary)]">₹1,00,00,000</td>
          </tr>
          <tr>
            <td class="font-medium text-[var(--color-text-primary)]">25 Years</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-emerald)] font-bold">₹5,270 / mo</td>
            <td class="font-[var(--font-mono)] text-sm">₹15,81,000</td>
            <td class="font-[var(--font-mono)] text-sm text-[var(--color-accent-emerald)] font-bold">₹84,19,000</td>
            <td class="font-[var(--font-mono)] text-sm font-bold text-[var(--color-text-primary)]">₹1,00,00,000</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Educational Formula Section -->
  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="glass-card-static p-6 md:p-8 space-y-4">
      <h3 class="font-[var(--font-heading)] font-semibold text-lg text-[var(--color-text-primary)]">
        The SIP Compounding Formula
      </h3>
      <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
        Mutual fund SIP uses the future value formula for an annuity due, because investments are made at regular intervals:
      </p>
      <div class="p-4 rounded-lg bg-[var(--color-bg-elevated)] border border-[var(--color-border)] font-mono text-center text-sm text-[var(--color-accent-emerald)]">
        M = P × [((1 + i)^n - 1) / i] × (1 + i)
      </div>
      <ul class="text-xs text-[var(--color-text-secondary)] space-y-1.5 list-disc list-inside">
        <li><strong>M</strong> = Expected maturity corpus</li>
        <li><strong>P</strong> = Monthly investment sum</li>
        <li><strong>i</strong> = Monthly interest rate (Annual Rate ÷ 12 ÷ 100)</li>
        <li><strong>n</strong> = Total number of monthly instalments</li>
      </ul>
    </div>

    <div class="glass-card-static p-6 md:p-8 space-y-4">
      <h3 class="font-[var(--font-heading)] font-semibold text-lg text-[var(--color-text-primary)]">
        3 Golden Rules of Wealth Creation via SIP
      </h3>
      <div class="space-y-3 text-xs text-[var(--color-text-secondary)]">
        <div class="p-3 rounded-lg bg-[var(--color-bg-elevated)] border border-[var(--color-border)]">
          <strong class="text-[var(--color-text-primary)] block mb-1">1. Start Early (Time Beats Timing)</strong>
          Starting at age 25 vs age 35 can mean 3x more wealth with the exact same monthly contribution due to exponential compounding.
        </div>
        <div class="p-3 rounded-lg bg-[var(--color-bg-elevated)] border border-[var(--color-border)]">
          <strong class="text-[var(--color-text-primary)] block mb-1">2. Step-Up Your SIP Annually</strong>
          Increasing your SIP amount by just 10% each year with your salary increment cuts your retirement timeline in half.
        </div>
        <div class="p-3 rounded-lg bg-[var(--color-bg-elevated)] border border-[var(--color-border)]">
          <strong class="text-[var(--color-text-primary)] block mb-1">3. Don't Pause in Market Dips</strong>
          Market corrections give you more mutual fund units at cheaper NAVs (Rupee Cost Averaging).
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div class="mt-10 glass-card-static p-6 md:p-8">
    <h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6 text-[var(--color-text-primary)]">
      Frequently Asked Questions (SIP & Mutual Funds)
    </h2>
    <div class="space-y-4">
      {faqData.mainEntity.map(faq => (
        <details class="group">
          <summary class="cursor-pointer text-[var(--color-text-primary)] font-medium text-sm sm:text-base flex items-center justify-between p-3.5 rounded-lg hover:bg-[var(--color-bg-elevated)] transition-colors">
            <span>{faq.name}</span>
            <svg class="w-4 h-4 text-[var(--color-text-muted)] group-open:rotate-180 transition-transform shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed p-3.5 pt-1">
            {faq.acceptedAnswer.text}
          </p>
        </details>
      ))}
    </div>
  </div>
</CalculatorLayout>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" defer></script>
<script>
  function fmt(n: number) {
    const s = Math.abs(Math.round(n)).toString();
    let f = s.length <= 3 ? s : '';
    if (s.length > 3) {
      f = s.slice(-3);
      let r = s.slice(0, -3);
      while (r.length > 2) {
        f = r.slice(-2) + ',' + f;
        r = r.slice(0, -2);
      }
      if (r.length) f = r + ',' + f;
    }
    return '₹' + f;
  }

  const amountSlider = document.getElementById('sip-amount') as HTMLInputElement;
  const amountInput = document.getElementById('sip-amount-input') as HTMLInputElement;
  const rateSlider = document.getElementById('sip-rate') as HTMLInputElement;
  const rateInput = document.getElementById('sip-rate-input') as HTMLInputElement;
  const tenureSlider = document.getElementById('sip-tenure') as HTMLInputElement;
  const tenureInput = document.getElementById('sip-tenure-input') as HTMLInputElement;

  function sync(slider: HTMLInputElement, input: HTMLInputElement, cb: () => void) {
    slider?.addEventListener('input', () => { input.value = slider.value; cb(); });
    input?.addEventListener('input', () => {
      let v = parseFloat(input.value);
      if (!isNaN(v)) {
        v = Math.max(parseFloat(slider.min), Math.min(parseFloat(slider.max), v));
        slider.value = String(v);
      }
      cb();
    });
  }

  sync(amountSlider, amountInput, calc);
  sync(rateSlider, rateInput, calc);
  sync(tenureSlider, tenureInput, calc);

  // Preset Chips Listener
  document.querySelectorAll('.preset-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-preset-for');
      const val = btn.getAttribute('data-val');
      if (!target || !val) return;

      const slider = document.getElementById(target) as HTMLInputElement;
      const input = document.getElementById(target + '-input') as HTMLInputElement;
      if (slider && input) {
        slider.value = val;
        input.value = val;
      }
      document.querySelectorAll(`[data-preset-for="${target}"]`).forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      calc();
    });
  });

  let chart: any = null;

  function calc() {
    const P = parseFloat(amountInput.value) || 0;
    const R = parseFloat(rateInput.value) || 0;
    const T = parseFloat(tenureInput.value) || 0;
    const n = T * 12;
    const r = R / 12 / 100;
    const fv = r > 0 ? P * ((Math.pow(1 + r, n) - 1) / r) * (1 + r) : P * n;
    const invested = P * n;
    const returns = fv - invested;

    document.getElementById('sip-total')!.textContent = fmt(fv);
    document.getElementById('sip-invested')!.textContent = fmt(invested);
    document.getElementById('sip-returns')!.textContent = fmt(returns);

    const canvas = document.getElementById('sip-chart') as HTMLCanvasElement;
    if (!canvas) return;
    if (chart) chart.destroy();

    // @ts-ignore
    chart = new Chart(canvas.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Invested Capital', 'Est. Wealth Gain'],
        datasets: [{
          data: [invested, returns],
          backgroundColor: ['#06b6d4', '#10b981'],
          borderColor: ['#090d16', '#090d16'],
          borderWidth: 3,
          hoverOffset: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        cutout: '72%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: { color: '#94a3b8', padding: 14, usePointStyle: true, font: { size: 12, family: 'Inter' } }
          },
          tooltip: {
            callbacks: {
              label: (c: any) => ` ${c.label}: ${fmt(c.raw)}`
            }
          }
        }
      }
    });
  }

  calc();
</script>
