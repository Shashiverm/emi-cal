---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---
<CalculatorLayout title="Retirement Calculator — Plan Your Retirement" description="Calculate retirement corpus needed, monthly savings required, and plan for a comfortable retirement." keywords="retirement calculator, retirement planning india, retirement corpus, retirement fund calculator" calculator="Retirement Calculator" category="Provident Fund & Retirement" categoryBadge="badge-retirement">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in"><h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6">Retirement Planning</h2>
      <div class="mb-5"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Current Age</label><div class="flex items-center gap-1"><input type="number" id="rt-age-input" class="num-input w-20 text-right" value="30" min="18" max="55"/></div></div><input type="range" id="rt-age" min="18" max="55" step="1" value="30"/></div>
      <div class="mb-5"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Retirement Age</label><div class="flex items-center gap-1"><input type="number" id="rt-ret-input" class="num-input w-20 text-right" value="60" min="40" max="70"/></div></div><input type="range" id="rt-ret" min="40" max="70" step="1" value="60"/></div>
      <div class="mb-5"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Monthly Expenses</label><div class="flex items-center gap-1"><span class="text-[var(--color-text-muted)] text-sm">₹</span><input type="number" id="rt-exp-input" class="num-input w-32 text-right" value="50000" min="5000" max="1000000" step="5000"/></div></div><input type="range" id="rt-exp" min="5000" max="1000000" step="5000" value="50000"/></div>
      <div class="mb-5"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Expected Inflation</label><div class="flex items-center gap-1"><input type="number" id="rt-inf-input" class="num-input w-20 text-right" value="6" min="2" max="12" step="0.5"/><span class="text-[var(--color-text-muted)] text-sm">%</span></div></div><input type="range" id="rt-inf" min="2" max="12" step="0.5" value="6"/></div>
      <div class="mb-5"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Expected Returns</label><div class="flex items-center gap-1"><input type="number" id="rt-ret-r-input" class="num-input w-20 text-right" value="10" min="5" max="20" step="0.5"/><span class="text-[var(--color-text-muted)] text-sm">%</span></div></div><input type="range" id="rt-ret-r" min="5" max="20" step="0.5" value="10"/></div></div>
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="glass-card p-6 md:p-8 animate-pulse-glow"><div class="text-sm text-[var(--color-text-muted)] mb-1">Retirement Corpus Needed</div><div id="rt-corpus" class="result-value gradient-text">₹0</div></div>
      <div class="glass-card p-5 border-l-4 border-l-[var(--color-accent-emerald)]"><div class="text-xs text-[var(--color-text-muted)] mb-1">Monthly Savings Required</div><div id="rt-monthly" class="font-[var(--font-mono)] font-bold text-2xl text-[var(--color-accent-emerald)]">₹0</div></div>
      <div class="grid grid-cols-2 gap-4"><div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Future Monthly Expenses</div><div id="rt-fut-exp" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-amber)]">₹0</div></div><div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Years to Retirement</div><div id="rt-years" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-indigo)]">0</div></div></div></div>
  </div>
</CalculatorLayout>
<script>function fmt(n){const s=Math.abs(Math.round(n)).toString();let f=s.length<=3?s:'';if(s.length>3){f=s.slice(-3);let r=s.slice(0,-3);while(r.length>2){f=r.slice(-2)+','+f;r=r.slice(0,-2);}if(r.length)f=r+','+f;}return '₹'+f;}
['rt-age','rt-ret','rt-exp','rt-inf','rt-ret-r'].forEach(function(id){var s=document.getElementById(id),i=document.getElementById(id+'-input');s&&s.addEventListener('input',function(){i.value=s.value;calc();});i&&i.addEventListener('input',function(){var v=parseFloat(i.value);if(!isNaN(v)){s.value=String(Math.max(parseFloat(s.min),Math.min(parseFloat(s.max),v)));}calc();});});
function calc(){var age=parseFloat(document.getElementById('rt-age-input').value)||0,retAge=parseFloat(document.getElementById('rt-ret-input').value)||0,exp=parseFloat(document.getElementById('rt-exp-input').value)||0,inf=parseFloat(document.getElementById('rt-inf-input').value)||0,ret=parseFloat(document.getElementById('rt-ret-r-input').value)||0;var yrs=retAge-age;if(yrs<=0)return;var futExp=exp*Math.pow(1+inf/100,yrs);var lifeExp=85;var retYrs=lifeExp-retAge;var realRet=((1+ret/100)/(1+inf/100))-1;var mRet=realRet/12;var retMonths=retYrs*12;var corpus=mRet>0?futExp*((1-Math.pow(1+mRet,-retMonths))/mRet):futExp*retMonths;var mReturn=ret/12/100;var savMonths=yrs*12;var monthly=corpus/(((Math.pow(1+mReturn,savMonths)-1)/mReturn)*(1+mReturn));document.getElementById('rt-corpus').textContent=fmt(corpus);document.getElementById('rt-monthly').textContent=fmt(monthly);document.getElementById('rt-fut-exp').textContent=fmt(futExp);document.getElementById('rt-years').textContent=yrs+' years';}calc();</script>
