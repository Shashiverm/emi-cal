---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---
<CalculatorLayout title="EPF Calculator — Employee Provident Fund" description="Calculate your EPF maturity amount with employee and employer contributions at current 8.25% rate." keywords="epf calculator, employee provident fund, pf calculator, epf interest rate, epf returns" calculator="EPF Calculator" category="Provident Fund & Retirement" categoryBadge="badge-retirement">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in"><h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6">EPF Details</h2>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Monthly Basic Salary</label><div class="flex items-center gap-1"><span class="text-[var(--color-text-muted)] text-sm">₹</span><input type="number" id="ep-a-input" class="num-input w-32 text-right" value="30000" min="5000" max="500000" step="1000"/></div></div><input type="range" id="ep-a" min="5000" max="500000" step="1000" value="30000"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>₹5K</span><span>₹5L</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Your Age</label><div class="flex items-center gap-1"><input type="number" id="ep-age-input" class="num-input w-20 text-right" value="25" min="18" max="55"/><span class="text-[var(--color-text-muted)] text-sm">Years</span></div></div><input type="range" id="ep-age" min="18" max="55" step="1" value="25"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>18</span><span>55</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">EPF Interest Rate</label><div class="flex items-center gap-1"><input type="number" id="ep-r-input" class="num-input w-24 text-right" value="8.25" min="5" max="12" step="0.05"/><span class="text-[var(--color-text-muted)] text-sm">%</span></div></div><input type="range" id="ep-r" min="5" max="12" step="0.05" value="8.25"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>5%</span><span>12%</span></div></div>
      <div class="p-3 rounded-lg bg-[var(--color-accent-indigo)]/10 border border-[var(--color-accent-indigo)]/20 text-xs text-[var(--color-text-secondary)]">💡 Employee: 12% of basic salary | Employer: 3.67% to EPF + 8.33% to EPS. Current EPF rate: <strong class="text-[var(--color-accent-indigo)]">8.25%</strong></div></div>
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="glass-card p-6 md:p-8 animate-pulse-glow"><div class="text-sm text-[var(--color-text-muted)] mb-1">EPF Maturity (at 58)</div><div id="ep-mat" class="result-value gradient-text">₹0</div></div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3"><div class="glass-card-static p-4"><div class="text-xs text-[var(--color-text-muted)] mb-1">Your Contribution</div><div id="ep-emp" class="font-[var(--font-mono)] font-bold text-base text-[var(--color-accent-cyan)]">₹0</div></div><div class="glass-card-static p-4"><div class="text-xs text-[var(--color-text-muted)] mb-1">Employer</div><div id="ep-empr" class="font-[var(--font-mono)] font-bold text-base text-[var(--color-accent-violet)]">₹0</div></div><div class="glass-card-static p-4"><div class="text-xs text-[var(--color-text-muted)] mb-1">Interest</div><div id="ep-int" class="font-[var(--font-mono)] font-bold text-base text-[var(--color-accent-emerald)]">₹0</div></div></div>
      <div class="glass-card-static p-6 flex justify-center"><div class="chart-container"><canvas id="ep-chart"></canvas></div></div></div>
  </div>
</CalculatorLayout>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" defer></script>
<script>function fmt(n){const s=Math.abs(Math.round(n)).toString();let f=s.length<=3?s:'';if(s.length>3){f=s.slice(-3);let r=s.slice(0,-3);while(r.length>2){f=r.slice(-2)+','+f;r=r.slice(0,-2);}if(r.length)f=r+','+f;}return '₹'+f;}let chart=null;['ep-a','ep-age','ep-r'].forEach(function(id){var s=document.getElementById(id),i=document.getElementById(id+'-input');s&&s.addEventListener('input',function(){i.value=s.value;calc();});i&&i.addEventListener('input',function(){var v=parseFloat(i.value);if(!isNaN(v)){s.value=String(Math.max(parseFloat(s.min),Math.min(parseFloat(s.max),v)));}calc();});});function calc(){var salary=parseFloat(document.getElementById('ep-a-input').value)||0,age=parseFloat(document.getElementById('ep-age-input').value)||0,R=parseFloat(document.getElementById('ep-r-input').value)||0;var years=58-age;if(years<=0)return;var empContrib=salary*0.12,emprContrib=salary*0.0367,total=empContrib+emprContrib,r=R/12/100,bal=0;for(var m=1;m<=years*12;m++){bal=(bal+total)*(1+r);}var totalEmp=Math.round(empContrib*years*12),totalEmpr=Math.round(emprContrib*years*12),interest=Math.round(bal-totalEmp-totalEmpr);document.getElementById('ep-mat').textContent=fmt(bal);document.getElementById('ep-emp').textContent=fmt(totalEmp);document.getElementById('ep-empr').textContent=fmt(totalEmpr);document.getElementById('ep-int').textContent=fmt(interest);var c=document.getElementById('ep-chart');if(!c)return;if(chart)chart.destroy();chart=new Chart(c.getContext('2d'),{type:'doughnut',data:{labels:['Your Contribution','Employer','Interest'],datasets:[{data:[totalEmp,totalEmpr,interest],backgroundColor:['#06b6d4','#8b5cf6','#10b981'],borderColor:['#0a0a0f','#0a0a0f','#0a0a0f'],borderWidth:3,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:true,cutout:'70%',plugins:{legend:{position:'bottom',labels:{color:'#9ca3af',padding:16,usePointStyle:true,font:{size:12}}},tooltip:{callbacks:{label:function(c){return ' '+c.label+': '+fmt(c.raw);}}}}}});}calc();</script>
