---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---
<CalculatorLayout title="Lumpsum Calculator — One-time Investment Returns" description="Calculate returns on your one-time lumpsum mutual fund investment with the power of compounding." keywords="lumpsum calculator, one time investment, lumpsum returns, mutual fund lumpsum" calculator="Lumpsum Calculator" category="Investment" categoryBadge="badge-investment">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in"><h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6">Investment Details</h2>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Investment Amount</label><div class="flex items-center gap-1"><span class="text-[var(--color-text-muted)] text-sm">₹</span><input type="number" id="ls-a-input" class="num-input w-36 text-right" value="500000" min="1000" max="100000000" step="10000"/></div></div><input type="range" id="ls-a" min="1000" max="100000000" step="10000" value="500000"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>₹1K</span><span>₹10Cr</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Expected Return (p.a.)</label><div class="flex items-center gap-1"><input type="number" id="ls-r-input" class="num-input w-24 text-right" value="12" min="1" max="30" step="0.5"/><span class="text-[var(--color-text-muted)] text-sm">%</span></div></div><input type="range" id="ls-r" min="1" max="30" step="0.5" value="12"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>1%</span><span>30%</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Time Period</label><div class="flex items-center gap-1"><input type="number" id="ls-t-input" class="num-input w-20 text-right" value="10" min="1" max="30"/><span class="text-[var(--color-text-muted)] text-sm">Years</span></div></div><input type="range" id="ls-t" min="1" max="30" step="1" value="10"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>1 Yr</span><span>30 Yr</span></div></div></div>
    <div class="flex flex-col gap-6 animate-fade-in-delay">
      <div class="glass-card p-6 md:p-8 animate-pulse-glow"><div class="text-sm text-[var(--color-text-muted)] mb-1">Total Value</div><div id="ls-total" class="result-value gradient-text">₹0</div></div>
      <div class="grid grid-cols-2 gap-4"><div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Invested</div><div id="ls-inv" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-cyan)]">₹0</div></div><div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Returns</div><div id="ls-ret" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-emerald)]">₹0</div></div></div>
      <div class="glass-card-static p-6 flex justify-center"><div class="chart-container"><canvas id="ls-chart"></canvas></div></div></div>
  </div>
</CalculatorLayout>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" defer></script>
<script>function fmt(n){const s=Math.abs(Math.round(n)).toString();let f=s.length<=3?s:'';if(s.length>3){f=s.slice(-3);let r=s.slice(0,-3);while(r.length>2){f=r.slice(-2)+','+f;r=r.slice(0,-2);}if(r.length)f=r+','+f;}return '₹'+f;}let chart=null;['ls-a','ls-r','ls-t'].forEach(function(id){var s=document.getElementById(id),i=document.getElementById(id+'-input');s&&s.addEventListener('input',function(){i.value=s.value;calc();});i&&i.addEventListener('input',function(){var v=parseFloat(i.value);if(!isNaN(v)){s.value=String(Math.max(parseFloat(s.min),Math.min(parseFloat(s.max),v)));}calc();});});function calc(){var P=parseFloat(document.getElementById('ls-a-input').value)||0,R=parseFloat(document.getElementById('ls-r-input').value)||0,T=parseFloat(document.getElementById('ls-t-input').value)||0;var fv=Math.round(P*Math.pow(1+R/100,T)),ret=fv-P;document.getElementById('ls-total').textContent=fmt(fv);document.getElementById('ls-inv').textContent=fmt(P);document.getElementById('ls-ret').textContent=fmt(ret);var c=document.getElementById('ls-chart');if(!c)return;if(chart)chart.destroy();chart=new Chart(c.getContext('2d'),{type:'doughnut',data:{labels:['Invested','Returns'],datasets:[{data:[P,ret],backgroundColor:['#06b6d4','#10b981'],borderColor:['#0a0a0f','#0a0a0f'],borderWidth:3,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:true,cutout:'70%',plugins:{legend:{position:'bottom',labels:{color:'#9ca3af',padding:16,usePointStyle:true,font:{size:12}}},tooltip:{callbacks:{label:function(c){return ' '+c.label+': '+fmt(c.raw);}}}}}});}calc();</script>
