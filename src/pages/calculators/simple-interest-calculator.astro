---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---
<CalculatorLayout
  title="Simple Interest Calculator — Calculate SI & Total Maturity Amount"
  description="Free online Simple Interest calculator to calculate interest earnings on loans, deposits, and bonds using the SI formula (P × R × T) / 100."
  keywords="simple interest calculator, si calculator, simple interest formula, interest on loan, maturity value"
  calculator="Simple Interest Calculator"
  category="Other"
  categoryBadge="badge-other"
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Input Section -->
    <div class="glass-card p-6 md:p-8 animate-fade-in space-y-6">
      <h2 class="font-[var(--font-heading)] font-semibold text-xl">Investment / Loan Details</h2>

      <!-- Principal -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="text-sm font-medium text-[var(--color-text-secondary)]">Principal Amount</label>
          <div class="flex items-center gap-1">
            <span class="text-[var(--color-text-muted)] text-sm">₹</span>
            <input type="number" id="si-p-input" class="num-input w-36 text-right" value="100000" min="1000" max="10000000" step="1000"/>
          </div>
        </div>
        <input type="range" id="si-p" min="1000" max="10000000" step="5000" value="100000"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1">
          <span>₹1K</span>
          <span>₹50 Lakh</span>
          <span>₹1 Crore</span>
        </div>
      </div>

      <!-- Interest Rate -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="text-sm font-medium text-[var(--color-text-secondary)]">Rate of Interest (p.a.)</label>
          <div class="flex items-center gap-1">
            <input type="number" id="si-r-input" class="num-input w-24 text-right" value="8" min="1" max="50" step="0.1"/>
            <span class="text-[var(--color-text-muted)] text-sm">%</span>
          </div>
        </div>
        <input type="range" id="si-r" min="1" max="30" step="0.1" value="8"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1">
          <span>1%</span>
          <span>15%</span>
          <span>30%</span>
        </div>
      </div>

      <!-- Time Period -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="text-sm font-medium text-[var(--color-text-secondary)]">Time Period</label>
          <div class="flex items-center gap-1">
            <input type="number" id="si-t-input" class="num-input w-24 text-right" value="5" min="0.5" max="30" step="0.5"/>
            <span class="text-[var(--color-text-muted)] text-sm">Years</span>
          </div>
        </div>
        <input type="range" id="si-t" min="1" max="30" step="1" value="5"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1">
          <span>1 Yr</span>
          <span>15 Yr</span>
          <span>30 Yr</span>
        </div>
      </div>

      <div class="p-3 rounded-lg bg-[var(--color-accent-indigo)]/10 border border-[var(--color-accent-indigo)]/20 text-xs text-[var(--color-text-secondary)]">
        💡 <strong>Formula:</strong> Simple Interest (SI) = (P × R × T) / 100, where P = Principal, R = Rate of Interest per annum, T = Time in years.
      </div>
    </div>

    <!-- Results Section -->
    <div class="flex flex-col gap-4 animate-fade-in-delay">
      <!-- Total Maturity Amount -->
      <div class="glass-card p-6 md:p-8 animate-pulse-glow">
        <div class="text-sm text-[var(--color-text-muted)] mb-1">Total Maturity Amount</div>
        <div id="si-total-val" class="result-value gradient-text">₹0</div>
        <div class="text-xs text-[var(--color-text-muted)] mt-2">Principal + Total Interest Earned.</div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="glass-card-static p-5">
          <div class="text-xs text-[var(--color-text-muted)] mb-1">Principal Amount</div>
          <div id="si-p-val" class="font-[var(--font-mono)] font-bold text-xl text-[var(--color-text-primary)]">₹0</div>
        </div>
        <div class="glass-card-static p-5">
          <div class="text-xs text-[var(--color-text-muted)] mb-1">Total Interest Earned</div>
          <div id="si-interest-val" class="font-[var(--font-mono)] font-bold text-xl text-[var(--color-accent-emerald)]">₹0</div>
        </div>
      </div>

      <!-- Ratio Bar -->
      <div class="glass-card-static p-5 space-y-3">
        <div class="flex justify-between text-xs text-[var(--color-text-secondary)]">
          <span>Principal: <strong id="si-p-pct" class="text-[var(--color-text-primary)]">0%</strong></span>
          <span>Interest: <strong id="si-i-pct" class="text-[var(--color-accent-emerald)]">0%</strong></span>
        </div>
        <div class="w-full h-3 bg-[var(--color-bg-tertiary)] rounded-full overflow-hidden flex">
          <div id="si-bar-p" class="h-full bg-[var(--color-accent-indigo)] transition-all duration-300" style="width: 50%"></div>
          <div id="si-bar-i" class="h-full bg-[var(--color-accent-emerald)] transition-all duration-300" style="width: 50%"></div>
        </div>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
function fmt(n) {
  const s = Math.abs(Math.round(n)).toString();
  let f = s.length <= 3 ? s : '';
  if (s.length > 3) {
    f = s.slice(-3);
    let r = s.slice(0, -3);
    while (r.length > 2) {
      f = r.slice(-2) + ',' + f;
      r = r.slice(0, -2);
    }
    if (r.length) f = r + ',' + f;
  }
  return '₹' + f;
}

['si-p', 'si-r', 'si-t'].forEach(id => {
  const s = document.getElementById(id) as HTMLInputElement;
  const i = document.getElementById(id + '-input') as HTMLInputElement;
  s.addEventListener('input', () => { i.value = s.value; calc(); });
  i.addEventListener('input', () => {
    const v = parseFloat(i.value);
    if (!isNaN(v)) s.value = String(Math.max(parseFloat(s.min), Math.min(parseFloat(s.max), v)));
    calc();
  });
});

function calc() {
  const p = parseFloat((document.getElementById('si-p-input') as HTMLInputElement).value) || 0;
  const r = parseFloat((document.getElementById('si-r-input') as HTMLInputElement).value) || 0;
  const t = parseFloat((document.getElementById('si-t-input') as HTMLInputElement).value) || 0;

  const interest = Math.round((p * r * t) / 100);
  const total = p + interest;

  document.getElementById('si-total-val')!.textContent = fmt(total);
  document.getElementById('si-p-val')!.textContent = fmt(p);
  document.getElementById('si-interest-val')!.textContent = fmt(interest);

  const pPct = total > 0 ? Math.round((p / total) * 100) : 100;
  const iPct = 100 - pPct;

  document.getElementById('si-p-pct')!.textContent = pPct + '%';
  document.getElementById('si-i-pct')!.textContent = iPct + '%';
  (document.getElementById('si-bar-p') as HTMLElement).style.width = pPct + '%';
  (document.getElementById('si-bar-i') as HTMLElement).style.width = iPct + '%';
}

calc();
</script>
