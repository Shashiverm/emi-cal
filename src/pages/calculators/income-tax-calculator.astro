      <div class="flex items-center gap-3">
        <span class="p-2 rounded-xl bg-amber-500/10 text-amber-400">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </span>
        <div>
          <h3 class="font-[var(--font-heading)] font-semibold text-lg text-[var(--color-text-primary)]">
            Union Budget 2024-25 / 2025-26 Directives & CBDT Rules
          </h3>
          <p class="text-xs text-[var(--color-text-muted)]">Official income tax revisions notified by the Ministry of Finance, Government of India</p>
        </div>
      </div>
      <a href="/regulatory-framework#budget-tax" class="inline-flex items-center gap-1.5 text-xs font-medium text-amber-400 hover:text-amber-300 bg-amber-950/40 border border-amber-800/60 px-3.5 py-2 rounded-lg transition-colors shrink-0">
        <span>View 2026 Tax Rules</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
      <div class="p-3.5 rounded-xl bg-[var(--color-bg-base)]/60 border border-[var(--color-border)]">
        <div class="font-semibold text-[var(--color-text-primary)] mb-1 flex items-center gap-1.5">
          <span class="text-emerald-400">✓</span> ₹75,000 Standard Deduction
        </div>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          Standard deduction under Section 16(ia) in the New Tax Regime is elevated from ₹50,000 to ₹75,000 for salaried employees and pensioners.
        </p>
      </div>

      <div class="p-3.5 rounded-xl bg-[var(--color-bg-base)]/60 border border-[var(--color-border)]">
        <div class="font-semibold text-[var(--color-text-primary)] mb-1 flex items-center gap-1.5">
          <span class="text-cyan-400">✓</span> Section 87A Zero Tax Threshold
        </div>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          Salaried individuals with a gross income of up to ₹7,75,000 pay zero tax thanks to the ₹75k deduction and Section 87A rebate.
        </p>
      </div>

      <div class="p-3.5 rounded-xl bg-[var(--color-bg-base)]/60 border border-[var(--color-border)]">
        <div class="font-semibold text-[var(--color-accent-rose)] mb-1 flex items-center gap-1.5">
          <span>⚡</span> Revised Capital Gains
        </div>
        <p class="text-[var(--color-text-muted)] leading-relaxed">
          Long Term Capital Gains (LTCG) on listed equity is 12.5% beyond ₹1.25L exemption. Short Term Capital Gains (STCG) on equity is 20%.
        </p>
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-[var(--color-border)] flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--color-text-muted)]">
      <span>Official tax filing & verification:</span>
      <div class="flex flex-wrap gap-3">
        <a href="https://eportal.incometax.gov.in" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">Income Tax e-Filing Portal ↗</a>
        <span class="text-[var(--color-border)]">•</span>
        <a href="https://incometaxindia.gov.in" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">CBDT Official Website ↗</a>
        <span class="text-[var(--color-border)]">•</span>
        <a href="https://services.gst.gov.in" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">GST Portal ↗</a>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div class="mt-10 glass-card-static p-6 md:p-8">
    <h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6 text-[var(--color-text-primary)]">
      Frequently Asked Questions (Income Tax & Slabs)
    </h2>
    <div class="space-y-4">
      {faqData.mainEntity.map(faq => (
        <details class="group">
          <summary class="cursor-pointer text-[var(--color-text-primary)] font-medium text-sm sm:text-base flex items-center justify-between p-3.5 rounded-lg hover:bg-[var(--color-bg-elevated)] transition-colors">
            <span>{faq.name}</span>
            <svg class="w-4 h-4 text-[var(--color-text-muted)] group-open:rotate-180 transition-transform shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed p-3.5 pt-1">
