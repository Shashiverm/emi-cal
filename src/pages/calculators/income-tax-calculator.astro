</CalculatorLayout>

<script>
function fmt(n: number) {
  const s = Math.abs(Math.round(n)).toString();
  let f = s.length <= 3 ? s : '';
  if (s.length > 3) {
    f = s.slice(-3);
    let r = s.slice(0, -3);
    while (r.length > 2) {
      f = r.slice(-2) + ',' + f;
      r = r.slice(0, -2);
    }
    if (r.length) f = r + ',' + f;
  }
  return '₹' + f;
}

const incSlider = document.getElementById('tax-income') as HTMLInputElement;
const incInput = document.getElementById('tax-income-input') as HTMLInputElement;
const empType = document.getElementById('tax-emp-type') as HTMLSelectElement;
const ageGroup = document.getElementById('tax-age-group') as HTMLSelectElement;

const ded80c = document.getElementById('ded-80c') as HTMLInputElement;
const ded80d = document.getElementById('ded-80d') as HTMLInputElement;
const dedOther = document.getElementById('ded-other') as HTMLInputElement;

incSlider?.addEventListener('input', () => { incInput.value = incSlider.value; calc(); });
incInput?.addEventListener('input', () => { incSlider.value = incInput.value; calc(); });
empType?.addEventListener('change', calc);
ageGroup?.addEventListener('change', calc);

// Preset chips listener
document.querySelectorAll('.preset-chip').forEach(btn => {
  btn.addEventListener('click', () => {
    const target = btn.getAttribute('data-preset-for');
    const val = btn.getAttribute('data-val');
    if (!target || !val) return;

    const slider = document.getElementById(target) as HTMLInputElement;
    const input = document.getElementById(target + '-input') as HTMLInputElement;
    if (slider && input) {
      slider.value = val;
      input.value = val;
    }
    document.querySelectorAll(`[data-preset-for="${target}"]`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    calc();
  });
});

[ded80c, ded80d, dedOther].forEach(el => {
  el?.addEventListener('input', () => {
    document.getElementById('val-' + (el.id === 'ded-other' ? 'hra' : el.id.slice(4)))!.textContent = fmt(parseFloat(el.value));
    calc();
  });
});

function calcNewRegime(gross: number, isSalaried: boolean): { tax: number; cess: number; total: number; taxable: number; stdDed: number } {
  const stdDed = isSalaried ? 75000 : 0;
  const taxable = Math.max(0, gross - stdDed);
  
  if (taxable <= 700000) {
    return { tax: 0, cess: 0, total: 0, taxable, stdDed };
  }

  let tax = 0;
  if (taxable > 1500000) tax += (taxable - 1500000) * 0.30 + 140000;
  else if (taxable > 1200000) tax += (taxable - 1200000) * 0.20 + 80000;
  else if (taxable > 1000000) tax += (taxable - 1000000) * 0.15 + 50000;
  else if (taxable > 700000) tax += (taxable - 700000) * 0.10 + 20000;
  else if (taxable > 300000) tax += (taxable - 300000) * 0.05;

  // Marginal relief check around 7L
  if (taxable > 700000 && taxable <= 727777) {
    tax = Math.min(tax, taxable - 700000);
  }

  const cess = tax * 0.04;
  return { tax, cess, total: Math.round(tax + cess), taxable, stdDed };
}

function calcOldRegime(gross: number, isSalaried: boolean, age: string, d80c: number, d80d: number, dOther: number) {
  const stdDed = isSalaried ? 50000 : 0;
  const totalDed = stdDed + d80c + d80d + dOther;
  const taxable = Math.max(0, gross - totalDed);

  if (taxable <= 500000) {
    return { tax: 0, cess: 0, total: 0, taxable, totalDed };
  }

  let exemptionLimit = 250000;
  if (age === 'senior') exemptionLimit = 300000;
  else if (age === 'super') exemptionLimit = 500000;

  let tax = 0;
  if (taxable > 1000000) {
    tax += (taxable - 1000000) * 0.30;
    tax += (1000000 - 500000) * 0.20;
    tax += (500000 - exemptionLimit) * 0.05;
  } else if (taxable > 500000) {
    tax += (taxable - 500000) * 0.20;
    tax += (500000 - exemptionLimit) * 0.05;
  } else if (taxable > exemptionLimit) {
    tax += (taxable - exemptionLimit) * 0.05;
  }

  const cess = tax * 0.04;
  return { tax, cess, total: Math.round(tax + cess), taxable, totalDed };
}

function calc() {
  const gross = parseFloat(incInput.value) || 0;
  const isSalaried = empType.value === 'salaried';
  const age = ageGroup.value;
  const d80c = parseFloat(ded80c.value) || 0;
  const d80d = parseFloat(ded80d.value) || 0;
  const dOther = parseFloat(dedOther.value) || 0;

  const n = calcNewRegime(gross, isSalaried);
  const o = calcOldRegime(gross, isSalaried, age, d80c, d80d, dOther);

  document.getElementById('new-tax-amt')!.textContent = fmt(n.total);
  document.getElementById('new-std-ded')!.textContent = fmt(n.stdDed);
  document.getElementById('new-taxable')!.textContent = fmt(n.taxable);
  document.getElementById('new-cess')!.textContent = fmt(n.cess);

  document.getElementById('old-tax-amt')!.textContent = fmt(o.total);
  document.getElementById('old-total-ded')!.textContent = fmt(o.totalDed);
  document.getElementById('old-taxable')!.textContent = fmt(o.taxable);
  document.getElementById('old-cess')!.textContent = fmt(o.cess);

  const diff = Math.abs(n.total - o.total);
  const verdictCard = document.getElementById('regime-verdict')!;
  const verdictTitle = document.getElementById('verdict-title')!;
  const verdictDesc = document.getElementById('verdict-desc')!;

  if (n.total < o.total) {
    verdictCard.className = 'glass-card p-6 border-2 border-[var(--color-accent-emerald)] bg-[var(--color-accent-emerald)]/5';
    verdictTitle.textContent = 'New Tax Regime is Better 🎉';
    verdictDesc.textContent = `You will save ${fmt(diff)} in taxes by filing under the New Tax Regime.`;
  } else if (o.total < n.total) {
    verdictCard.className = 'glass-card p-6 border-2 border-[var(--color-accent-indigo)] bg-[var(--color-accent-indigo)]/5';
    verdictTitle.textContent = 'Old Tax Regime is Better 🎉';
    verdictDesc.textContent = `You will save ${fmt(diff)} in taxes by filing under the Old Tax Regime with your deductions.`;
  } else {
    verdictCard.className = 'glass-card p-6 border-2 border-[var(--color-border)]';
    verdictTitle.textContent = 'Both Regimes Result in the Same Tax';
    verdictDesc.textContent = 'Your tax liability is identical in both tax regimes.';
  }
}

calc();
</script>
