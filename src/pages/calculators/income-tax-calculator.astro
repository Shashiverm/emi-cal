        </div>
        <div>
          <label for="tax-age-group" class="block text-xs font-medium text-[var(--color-text-muted)] mb-1">Age Category</label>
          <select id="tax-age-group" class="w-full bg-[var(--color-bg-elevated)] border border-[var(--color-border)] rounded-lg p-2.5 text-sm text-[var(--color-text-primary)]">
