---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the new tax slab rate for FY 2024-25 and FY 2025-26?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under the New Tax Regime revised in the Union Budget, tax rates are: Up to ₹3 Lakh: Nil, ₹3L to ₹7L: 5%, ₹7L to ₹10L: 10%, ₹10L to ₹12L: 15%, ₹12L to ₹15L: 20%, Above ₹15L: 30%. Salaried employees get an enhanced standard deduction of ₹75,000."
      }
    },
    {
      "@type": "Question",
      "name": "Is income up to ₹7.75 Lakh completely tax-free for salaried individuals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! For salaried individuals under the New Tax Regime, after deducting the ₹75,000 standard deduction, a gross salary of up to ₹7,75,000 results in a net taxable income of ₹7,00,000. Full tax rebate under Section 87A applies, reducing tax liability to ₹0."
      }
    },
    {
      "@type": "Question",
      "name": "Which is better for me: Old Tax Regime or New Tax Regime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Old Regime is usually better if your total deductions (Section 80C ₹1.5L, Section 80D health insurance, HRA / Section 24b home loan interest) exceed ₹3.75 Lakh to ₹4.25 Lakh depending on your income bracket. For those with fewer investments or lower rent, the New Tax Regime offers lower slab rates without locking money in tax-saving instruments."
      }
    },
    {
      "@type": "Question",
      "name": "Can salaried employees switch between Old and New regimes every year?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Individuals with salary income (and no business or professional income) have the flexibility to choose either the Old or New Tax Regime every financial year at the time of filing their Income Tax Return (ITR)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the standard deduction for salaried individuals in the New Tax Regime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The standard deduction under the New Tax Regime has been increased to ₹75,000 (up from ₹50,000 previously). Under the Old Tax Regime, the standard deduction remains ₹50,000."
      }
    }
  ]
};
---

<CalculatorLayout
  title="Income Tax Calculator — Old vs New Regime (FY 2024-25 / 2025-26)"
  description="Compare your tax liability under Old and New Tax Regimes with Standard Deduction (₹75k), 80C, 80D, HRA & Home Loan deductions. Instant recommendation on maximum tax savings."
  keywords="income tax calculator 2024-25, income tax calculator 2025-26, old vs new tax regime, tax calculator india, income tax slab fy 2024-25, standard deduction 75000, 80c tax exemption, section 87a rebate"
  calculator="Income Tax Calculator"
  category="Tax & Salary"
  categoryBadge="badge-tax"
  structuredData={faqData}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Inputs Column -->
    <div class="lg:col-span-7 glass-card p-6 md:p-8 animate-fade-in space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
        <h2 class="font-[var(--font-heading)] font-semibold text-lg sm:text-xl text-[var(--color-text-primary)]">
          Income & Deduction Details
        </h2>
        <span class="text-xs text-[var(--color-accent-amber)] font-medium">Budget 2024-25 Updated</span>
      </div>

      <!-- Annual Income -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="tax-income" class="text-sm font-medium text-[var(--color-text-secondary)]">Gross Annual Income (CTC)</label>
          <div class="flex items-center gap-1">
            <span class="text-[var(--color-text-muted)] text-sm">₹</span>
            <input type="number" id="tax-income-input" class="num-input w-36 text-right" value="1200000" min="100000" max="10000000" step="25000"/>
          </div>
        </div>
        <input type="range" id="tax-income" min="100000" max="10000000" step="25000" value="1200000"/>
        <div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1.5 mb-2.5">
          <span>₹1 Lakh</span>
          <span>₹12 Lakh</span>
          <span>₹1 Crore</span>
        </div>
        <!-- Salary Presets -->
        <div class="flex flex-wrap gap-1.5 pt-1">
          <button type="button" class="preset-chip" data-preset-for="tax-income" data-val="600000">₹6L</button>
          <button type="button" class="preset-chip" data-preset-for="tax-income" data-val="775000">₹7.75L (Zero Tax)</button>
          <button type="button" class="preset-chip" data-preset-for="tax-income" data-val="1000000">₹10L</button>
          <button type="button" class="preset-chip active" data-preset-for="tax-income" data-val="1200000">₹12L</button>
          <button type="button" class="preset-chip" data-preset-for="tax-income" data-val="1500000">₹15L</button>
          <button type="button" class="preset-chip" data-preset-for="tax-income" data-val="2500000">₹25L</button>
          <button type="button" class="preset-chip" data-preset-for="tax-income" data-val="5000000">₹50L</button>
        </div>
      </div>

      <!-- User Type -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="tax-emp-type" class="block text-xs font-medium text-[var(--color-text-muted)] mb-1">Employment Type</label>
          <select id="tax-emp-type" class="w-full bg-[var(--color-bg-elevated)] border border-[var(--color-border)] rounded-lg p-2.5 text-sm text-[var(--color-text-primary)]">
            <option value="salaried" selected>Salaried Individual (Std Ded ₹75k)</option>
            <option value="business">Self-Employed / Freelancer / Business</option>
