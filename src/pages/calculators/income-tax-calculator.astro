          <div class="text-xs text-[var(--color-text-muted)] mb-0.5">Total Tax Payable</div>
          <div id="old-tax-amt" class="text-2xl font-bold font-[var(--font-mono)] text-[var(--color-text-primary)]">₹0</div>
          
          <div class="mt-4 pt-3 border-t border-[var(--color-border)] space-y-1.5 text-xs">
            <div class="flex justify-between text-[var(--color-text-muted)]">
              <span>Total Deductions:</span>
              <span id="old-total-ded" class="font-mono text-[var(--color-text-primary)]">₹0</span>
            </div>
            <div class="flex justify-between text-[var(--color-text-muted)]">
