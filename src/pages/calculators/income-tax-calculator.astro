    </div>

    <!-- Comparison Results Column -->
    <div class="lg:col-span-5 flex flex-col gap-4 animate-fade-in-delay">
      <!-- Verdict Card -->
      <div id="regime-verdict" class="glass-card p-6 border-2 border-[var(--color-accent-emerald)] bg-[var(--color-accent-emerald)]/5">
        <div class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-emerald)] mb-1">Recommendation</div>
        <div id="verdict-title" class="text-xl font-bold text-[var(--color-text-primary)]">New Regime is Better</div>
        <div id="verdict-desc" class="text-sm text-[var(--color-text-secondary)] mt-1">You save ₹15,600 by choosing the New Tax Regime.</div>
      </div>

      <!-- Side-by-Side Comparison -->
