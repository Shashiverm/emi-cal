      </div>
    </div>
  </div>

  <!-- Union Budget & CBDT 2026 Directives Banner -->
  <div class="mt-8 rounded-2xl bg-gradient-to-r from-[var(--color-bg-surface)] to-[var(--color-bg-elevated)] border border-amber-500/30 p-6 md:p-8 shadow-lg">
