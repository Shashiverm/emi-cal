---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
---
<CalculatorLayout title="Gratuity Calculator" description="Calculate gratuity amount based on years of service and last drawn salary." keywords="gratuity calculator, gratuity calculation, gratuity amount, gratuity formula" calculator="Gratuity Calculator" category="Provident Fund & Retirement" categoryBadge="badge-retirement">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="glass-card p-6 md:p-8 animate-fade-in"><h2 class="font-[var(--font-heading)] font-semibold text-xl mb-6">Gratuity Details</h2>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Last Drawn Basic + DA</label><div class="flex items-center gap-1"><span class="text-[var(--color-text-muted)] text-sm">₹</span><input type="number" id="gr-sal-input" class="num-input w-32 text-right" value="50000" min="5000" max="1000000" step="1000"/></div></div><input type="range" id="gr-sal" min="5000" max="1000000" step="1000" value="50000"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>₹5K</span><span>₹10L</span></div></div>
      <div class="mb-6"><div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--color-text-secondary)]">Years of Service</label><div class="flex items-center gap-1"><input type="number" id="gr-yrs-input" class="num-input w-20 text-right" value="15" min="5" max="40"/><span class="text-[var(--color-text-muted)] text-sm">Years</span></div></div><input type="range" id="gr-yrs" min="5" max="40" step="1" value="15"/><div class="flex justify-between text-xs text-[var(--color-text-muted)] mt-1"><span>5 Yr</span><span>40 Yr</span></div></div>
      <div class="p-3 rounded-lg bg-[var(--color-accent-indigo)]/10 border border-[var(--color-accent-indigo)]/20 text-xs text-[var(--color-text-secondary)]">💡 Formula: Gratuity = (15 × Last Drawn Salary × Years of Service) / 26. Minimum 5 years of service required. Max tax-free limit: ₹20 lakhs.</div></div>
    <div class="flex flex-col gap-4 animate-fade-in-delay">
      <div class="glass-card p-6 md:p-8 animate-pulse-glow"><div class="text-sm text-[var(--color-text-muted)] mb-1">Gratuity Amount</div><div id="gr-amt" class="result-value gradient-text">₹0</div></div>
      <div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Tax-Free Limit</div><div class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-emerald)]">₹20,00,000</div></div>
      <div class="glass-card-static p-5"><div class="text-xs text-[var(--color-text-muted)] mb-1">Taxable Gratuity</div><div id="gr-tax" class="font-[var(--font-mono)] font-bold text-lg text-[var(--color-accent-amber)]">₹0</div></div></div>
  </div>
</CalculatorLayout>
<script>function fmt(n){const s=Math.abs(Math.round(n)).toString();let f=s.length<=3?s:'';if(s.length>3){f=s.slice(-3);let r=s.slice(0,-3);while(r.length>2){f=r.slice(-2)+','+f;r=r.slice(0,-2);}if(r.length)f=r+','+f;}return '₹'+f;}
['gr-sal','gr-yrs'].forEach(function(id){var s=document.getElementById(id),i=document.getElementById(id+'-input');s&&s.addEventListener('input',function(){i.value=s.value;calc();});i&&i.addEventListener('input',function(){var v=parseFloat(i.value);if(!isNaN(v)){s.value=String(Math.max(parseFloat(s.min),Math.min(parseFloat(s.max),v)));}calc();});});
function calc(){var sal=parseFloat(document.getElementById('gr-sal-input').value)||0,yrs=parseFloat(document.getElementById('gr-yrs-input').value)||0;var gratuity=Math.round((15*sal*yrs)/26);document.getElementById('gr-amt').textContent=fmt(gratuity);var taxable=Math.max(0,gratuity-2000000);document.getElementById('gr-tax').textContent=taxable>0?fmt(taxable):'₹0 (Tax Free)';}calc();</script>
